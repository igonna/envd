#!/usr/bin/env bash
set -euo pipefail

NETWORK="vpn-gateway_inside"
IMAGE="sshdev:24.04"
NET_IMAGE="devnet-sidecar:1"
PORT_FWD_IMAGE="alpine/socat:latest"
PORT_BASE=2223
PORT_MAX=2299

LABEL_KEY="dev-env.managed"
LABEL_VAL="true"
ROLE_KEY="dev-env.role"
ROLE_DEV="dev"
ROLE_NET="net"
ROLE_PORT="port"

SSHCFG="${HOME}/.ssh/config"
KNOWN_HOSTS_DEV="${HOME}/.ssh/known_hosts_dev_env"
KEY_PRIV="${HOME}/.ssh/id_ed25519"
KEY_PUB="${HOME}/.ssh/id_ed25519.pub"

usage() {
  cat <<'EOT'
Usage:
  dev-env help
  dev-env list
  dev-env new <name>
  dev-env rm <name>
  dev-env ssh <name>
  dev-env restart <name>
  dev-env cd <name>
  dev-env port-open <name> <container-port> [host-port]
  dev-env port-close <name> <container-port> [host-port]
  dev-env port-list [name]

Naming rule (enforced):
- <name> is also the Linux username inside the container.
- Must match: ^[a-z][a-z0-9]{0,31}$
  Examples: dev1, dev2, alice, alice2
  Not allowed: dev-1, Dev1, dev_1
EOT
}

die(){ echo "ERROR: $*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Missing: $1"; }

need docker
need nc
need ssh
need ssh-keygen
need awk

cmd="${1:-help}"
name="${2:-}"

ensure_ssh_key() {
  mkdir -p ~/.ssh
  chmod 700 ~/.ssh
  if [[ ! -f "$KEY_PRIV" || ! -f "$KEY_PUB" ]]; then
    echo "Generating SSH key at $KEY_PRIV"
    ssh-keygen -t ed25519 -f "$KEY_PRIV" -N "" >/dev/null
  fi
}

ensure_network_and_image() {
  docker network inspect "$NETWORK" >/dev/null 2>&1 || die "Network '$NETWORK' not found. Start vpn-gateway first."
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "Image '$IMAGE' not found. Build it first: docker build -t $IMAGE <path>"
  docker image inspect "$NET_IMAGE" >/dev/null 2>&1 || die "Image '$NET_IMAGE' not found. Build it first: docker build -t $NET_IMAGE <path-to-dev-containers/net-sidecar>"
}

pick_port() {
  local p=$PORT_BASE
  while [[ $p -le $PORT_MAX ]]; do
    if ! nc -z 127.0.0.1 "$p" >/dev/null 2>&1; then
      echo "$p"; return 0
    fi
    p=$((p+1))
  done
  return 1
}

ensure_port_number() {
  local p="$1" field="$2"
  [[ "$p" =~ ^[0-9]+$ ]] || die "Invalid ${field}: '${p}' (must be numeric)"
  (( p >= 1 && p <= 65535 )) || die "Invalid ${field}: '${p}' (must be 1-65535)"
}

port_fwd_name() {
  local env_name="$1" host_port="$2" container_port="$3"
  echo "${env_name}-pf-${host_port}-${container_port}"
}

ensure_port_forward_image() {
  docker image inspect "$PORT_FWD_IMAGE" >/dev/null 2>&1 || docker pull "$PORT_FWD_IMAGE" >/dev/null
}

allow_sidecar_port() {
  local env_name="$1" target_port="$2"
  docker exec "${env_name}-net" sh -lc \
    "iptables -C INPUT -p tcp --dport ${target_port} -j ACCEPT >/dev/null 2>&1 || iptables -I INPUT 1 -p tcp --dport ${target_port} -j ACCEPT"
}

deny_sidecar_port() {
  local env_name="$1" target_port="$2"
  docker exec "${env_name}-net" sh -lc \
    "iptables -D INPUT -p tcp --dport ${target_port} -j ACCEPT >/dev/null 2>&1 || true"
}

wait_for_healthy() {
  local container="$1"
  for _ in {1..80}; do
    local status
    status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container" 2>/dev/null || true)"
    if [[ "$status" == "healthy" ]]; then
      return 0
    fi
    if [[ "$status" == "unhealthy" ]]; then
      return 1
    fi
    sleep 0.25
  done
  return 1
}

remove_ssh_config_host() {
  local host="$1"
  [[ -f "$SSHCFG" ]] || return 0
  awk -v h="$host" '
    BEGIN{skip=0}
    $1=="Host" && $2==h {skip=1; next}
    $1=="Host" && skip==1 {skip=0}
    skip==0 {print}
  ' "$SSHCFG" > "${SSHCFG}.tmp"
  mv "${SSHCFG}.tmp" "$SSHCFG"
}

remove_known_host_entry() {
  local host="$1" port="$2"
  mkdir -p "${HOME}/.ssh"
  touch "$KNOWN_HOSTS_DEV"
  chmod 600 "$KNOWN_HOSTS_DEV"
  ssh-keygen -R "[${host}]:${port}" -f "$KNOWN_HOSTS_DEV" >/dev/null 2>&1 || true
}

set_ssh_config_host() {
  local host="$1" port="$2" user="$3"

  touch "$SSHCFG"
  chmod 600 "$SSHCFG"

  # remove old block if exists
  remove_ssh_config_host "$host"
  # avoid stale key mismatch when a recreated env reuses the same local port
  remove_known_host_entry "127.0.0.1" "$port"

  cat >> "$SSHCFG" <<EOCFG

Host ${host}
  HostName 127.0.0.1
  Port ${port}
  User ${user}
  IdentityFile ${KEY_PRIV}
  IdentitiesOnly yes
  ForwardAgent yes
  UserKnownHostsFile ~/.ssh/known_hosts_dev_env
  StrictHostKeyChecking accept-new

EOCFG
}

validate_name_and_user() {
  local n="$1"
  [[ "$n" =~ ^[a-z][a-z0-9]{0,31}$ ]] || die "Invalid name '$n'. Must match: ^[a-z][a-z0-9]{0,31}$ (example: dev1, alice2)."
}

case "$cmd" in
  help|-h|--help|"")
    usage
    ;;

  list)
    echo -e "NAME\tSTATUS\tIMAGE"
    docker ps -a --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --format "{{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Label \"$ROLE_KEY\"}}" \
      | awk -F '\t' 'BEGIN{OFS="\t"} { if ($4 == "net" || $4 == "port" || $1 ~ /-net$/) next; print $1, $2, $3 }'
    ;;

  new)
    [[ -z "$name" ]] && die "Usage: dev-env new <name>"
    validate_name_and_user "$name"
    ensure_network_and_image
    ensure_ssh_key

    docker inspect "$name" >/dev/null 2>&1 && die "Container '$name' already exists."

    USER_NAME="$name"
    NET_NAME="${name}-net"
    HOST_GIT_NAME="$(git config --global --get user.name 2>/dev/null || true)"
    HOST_GIT_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"
    PORT="$(pick_port)" || die "No free port in ${PORT_BASE}-${PORT_MAX}"

    HOME_VOL="${name}-home"
    REPO_VOL="${name}-repo"
    created_home_vol="false"
    created_repo_vol="false"
    created_net="false"
    created_dev="false"

    cleanup_partial_new() {
      local code=$?
      if [[ $code -eq 0 ]]; then
        return 0
      fi

      [[ "$created_dev" == "true" ]] && docker rm -f "$name" >/dev/null 2>&1 || true
      [[ "$created_net" == "true" ]] && docker rm -f "$NET_NAME" >/dev/null 2>&1 || true
      [[ "$created_home_vol" == "true" ]] && docker volume rm "$HOME_VOL" >/dev/null 2>&1 || true
      [[ "$created_repo_vol" == "true" ]] && docker volume rm "$REPO_VOL" >/dev/null 2>&1 || true
    }
    trap cleanup_partial_new EXIT

    docker inspect "$NET_NAME" >/dev/null 2>&1 && die "Sidecar '$NET_NAME' already exists."

    docker volume create "$HOME_VOL" >/dev/null
    created_home_vol="true"
    docker volume create "$REPO_VOL" >/dev/null
    created_repo_vol="true"

    docker run -d \
      --name "$NET_NAME" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_NET" \
      --restart unless-stopped \
      --network "$NETWORK" \
      --cap-add NET_ADMIN \
      --device /dev/net/tun \
      -e XRAY_HOST="xray" \
      -e XRAY_PORT="1080" \
      -p "127.0.0.1:${PORT}:22" \
      "$NET_IMAGE" >/dev/null
    created_net="true"

    wait_for_healthy "$NET_NAME" || die "Sidecar '$NET_NAME' did not become healthy."

    REPO_MOUNT="/home/${USER_NAME}/repo"

    docker run -d \
      --name "$name" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_DEV" \
      --restart unless-stopped \
      --network "container:${NET_NAME}" \
      -e DEV_USER="$USER_NAME" \
      -e REPO_DIR="$REPO_MOUNT" \
      -e GIT_USER_NAME="$HOST_GIT_NAME" \
      -e GIT_USER_EMAIL="$HOST_GIT_EMAIL" \
      -v "${HOME_VOL}:/home/${USER_NAME}" \
      -v "${REPO_VOL}:${REPO_MOUNT}" \
      "$IMAGE" >/dev/null
    created_dev="true"

    for _ in {1..50}; do
      nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 && break
      sleep 0.1
    done
    nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 || die "SSH port ${PORT} did not open for '$name'."

    docker exec -u root "$name" bash -lc "mkdir -p /home/${USER_NAME}/.ssh && chmod 700 /home/${USER_NAME}/.ssh && chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME}/.ssh" >/dev/null
    docker cp "$KEY_PUB" "${name}:/home/${USER_NAME}/.ssh/authorized_keys"
    docker exec -u root "$name" bash -lc "chown ${USER_NAME}:${USER_NAME} /home/${USER_NAME}/.ssh/authorized_keys && chmod 600 /home/${USER_NAME}/.ssh/authorized_keys" >/dev/null

    set_ssh_config_host "$name" "$PORT" "$USER_NAME"
    trap - EXIT

    echo "Created: $name"
    echo "  Network sidecar: $NET_NAME"
    echo "  Linux user: $USER_NAME"
    echo "  SSH: dev-env ssh $name   (or: ssh $name)"
    echo "  Repo: /repo -> ${REPO_MOUNT} (volume: ${REPO_VOL})"
    echo "  Home: /home/${USER_NAME} (volume: ${HOME_VOL})"
    if [[ -n "$HOST_GIT_NAME" && -n "$HOST_GIT_EMAIL" ]]; then
      echo "  Git identity: ${HOST_GIT_NAME} <${HOST_GIT_EMAIL}>"
    else
      echo "  Git identity: not set on host (run: git config --global user.name/user.email)"
    fi
    echo "  Port: 127.0.0.1:${PORT}"
    ;;

  rm)
    [[ -z "$name" ]] && die "Usage: dev-env rm <name>"
    validate_name_and_user "$name"

    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    docker rm -f "$name" >/dev/null
    docker rm -f "${name}-net" >/dev/null 2>&1 || true
    pf_ids="$(docker ps -a \
      --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --filter "label=$ROLE_KEY=$ROLE_PORT" \
      --filter "label=dev-env.name=$name" \
      --format '{{.ID}}')"
    if [[ -n "$pf_ids" ]]; then
      docker rm -f $pf_ids >/dev/null 2>&1 || true
    fi

    docker volume rm "${name}-home" >/dev/null 2>&1 || true
    docker volume rm "${name}-repo" >/dev/null 2>&1 || true

    remove_ssh_config_host "$name"

    echo "Removed: $name"
    echo "  Deleted volumes: ${name}-home, ${name}-repo"
    ;;

  ssh)
    [[ -z "$name" ]] && die "Usage: dev-env ssh <name>"
    validate_name_and_user "$name"
    ssh-add --apple-use-keychain ~/.ssh/ghub_key >/dev/null 2>&1 || true
    exec ssh -A "$name"
    ;;

  restart)
    [[ -z "$name" ]] && die "Usage: dev-env restart <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      docker restart "${name}-net" >/dev/null
    fi
    docker restart "$name" >/dev/null
    mapped_ports="$(docker ps -a \
      --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --filter "label=$ROLE_KEY=$ROLE_PORT" \
      --filter "label=dev-env.name=$name" \
      --format '{{.Label "dev-env.target_port"}}')"
    if [[ -n "$mapped_ports" ]]; then
      while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        allow_sidecar_port "$name" "$p"
      done <<< "$mapped_ports"
    fi
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      echo "Restarted: $name (and ${name}-net)"
    else
      echo "Restarted: $name"
    fi
    ;;

  cd)
    [[ -z "$name" ]] && die "Usage: dev-env cd <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    exec docker exec -it -u "$name" "$name" bash -lc 'cd /repo && exec bash'
    ;;

  port-open)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env port-open <name> <container-port> [host-port]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    docker inspect "${name}-net" >/dev/null 2>&1 || die "No such sidecar: ${name}-net"

    CONTAINER_PORT="$3"
    HOST_PORT="${4:-$CONTAINER_PORT}"
    ensure_port_number "$CONTAINER_PORT" "container-port"
    ensure_port_number "$HOST_PORT" "host-port"

    PF_NAME="$(port_fwd_name "$name" "$HOST_PORT" "$CONTAINER_PORT")"
    docker inspect "$PF_NAME" >/dev/null 2>&1 && die "Port forward already exists: $PF_NAME"
    nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 && die "Host port ${HOST_PORT} is already in use."

    ensure_port_forward_image
    allow_sidecar_port "$name" "$CONTAINER_PORT"
    docker run -d \
      --name "$PF_NAME" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_PORT" \
      --label "dev-env.name=$name" \
      --label "dev-env.host_port=$HOST_PORT" \
      --label "dev-env.target_port=$CONTAINER_PORT" \
      --restart unless-stopped \
      --network "$NETWORK" \
      -p "127.0.0.1:${HOST_PORT}:${HOST_PORT}" \
      "$PORT_FWD_IMAGE" \
      "TCP-LISTEN:${HOST_PORT},fork,reuseaddr,bind=0.0.0.0" \
      "TCP:${name}-net:${CONTAINER_PORT}" >/dev/null

    for _ in {1..30}; do
      nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 && break
      sleep 0.1
    done
    nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 || die "Port forward did not become ready on 127.0.0.1:${HOST_PORT}"

    echo "Opened: 127.0.0.1:${HOST_PORT} -> ${name}:${CONTAINER_PORT}"
    ;;

  port-close)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env port-close <name> <container-port> [host-port]"
    validate_name_and_user "$name"

    CONTAINER_PORT="$3"
    HOST_PORT="${4:-$CONTAINER_PORT}"
    ensure_port_number "$CONTAINER_PORT" "container-port"
    ensure_port_number "$HOST_PORT" "host-port"

    PF_NAME="$(port_fwd_name "$name" "$HOST_PORT" "$CONTAINER_PORT")"
    docker inspect "$PF_NAME" >/dev/null 2>&1 || die "No such port forward: $PF_NAME"
    docker rm -f "$PF_NAME" >/dev/null
    remaining_same_target="$(docker ps -a \
      --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --filter "label=$ROLE_KEY=$ROLE_PORT" \
      --filter "label=dev-env.name=$name" \
      --filter "label=dev-env.target_port=$CONTAINER_PORT" \
      --format '{{.ID}}')"
    if [[ -z "$remaining_same_target" ]]; then
      deny_sidecar_port "$name" "$CONTAINER_PORT"
    fi
    echo "Closed: 127.0.0.1:${HOST_PORT} -> ${name}:${CONTAINER_PORT}"
    ;;

  port-list)
    if [[ $# -gt 2 ]]; then
      die "Usage: dev-env port-list [name]"
    fi

    echo -e "NAME\tSTATUS\tENV\tHOST_PORT\tTARGET_PORT"
    if [[ $# -eq 2 ]]; then
      validate_name_and_user "$name"
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_PORT" \
        --filter "label=dev-env.name=$name" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"dev-env.name\"}}\t{{.Label \"dev-env.host_port\"}}\t{{.Label \"dev-env.target_port\"}}"
    else
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_PORT" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"dev-env.name\"}}\t{{.Label \"dev-env.host_port\"}}\t{{.Label \"dev-env.target_port\"}}"
    fi
    ;;

  *)
    usage
    die "Unknown command: $cmd"
    ;;
esac
