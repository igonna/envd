#!/usr/bin/env bash
set -euo pipefail

NETWORK="vpn-gateway_inside"
IMAGE="sshdev:24.04"
NET_IMAGE="devnet-sidecar:1"
PORT_FWD_IMAGE="alpine/socat:latest"
PORT_BASE=2223
PORT_MAX=2299

LABEL_KEY="dev-env.managed"
LABEL_VAL="true"
ROLE_KEY="dev-env.role"
ROLE_DEV="dev"
ROLE_NET="net"
ROLE_PORT="port"
ROLE_SVC="svc"
AUTOMATIONS_MOUNT="/automations"

SSHCFG="${HOME}/.ssh/config"
KNOWN_HOSTS_DEV="${HOME}/.ssh/known_hosts_dev_env"
KEY_PRIV="${HOME}/.ssh/id_ed25519"
KEY_PUB="${HOME}/.ssh/id_ed25519.pub"

usage() {
  cat <<'EOT'
Usage:
  dev-env help
  dev-env list
  dev-env new <name>
  dev-env rm <name>
  dev-env ssh <name>
  dev-env start <name>
  dev-env stop <name>
  dev-env restart <name>
  dev-env cd <name>
  dev-env svc-new <name> <service> [instance]
  dev-env svc-new-custom <name> <service> [instance]
  dev-env svc-start <name> <service> [instance]
  dev-env svc-stop <name> <service> [instance]
  dev-env svc-rm <name> <service> [instance]
  dev-env svc-list [name]
  dev-env svc-catalog
  dev-env svc-info <name> <service> [instance]
  dev-env port-open <name> <container-port> [host-port]
  dev-env port-close <name> <container-port> [host-port]
  dev-env port-list [name]

Naming rule (enforced):
- <name> is also the Linux username inside the container.
- Must match: ^[a-z][a-z0-9]{0,31}$
  Examples: dev1, dev2, alice, alice2
  Not allowed: dev-1, Dev1, dev_1
EOT
}

die(){ echo "ERROR: $*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Missing: $1"; }

need docker
need nc
need ssh
need ssh-keygen
need awk

cmd="${1:-help}"
name="${2:-}"

ensure_ssh_key() {
  mkdir -p ~/.ssh
  chmod 700 ~/.ssh
  if [[ ! -f "$KEY_PRIV" || ! -f "$KEY_PUB" ]]; then
    echo "Generating SSH key at $KEY_PRIV"
    ssh-keygen -t ed25519 -f "$KEY_PRIV" -N "" >/dev/null
  fi
}

resolve_automations_dir() {
  local d
  if [[ -n "${DEV_ENV_AUTOMATIONS_DIR:-}" ]]; then
    [[ -d "$DEV_ENV_AUTOMATIONS_DIR" ]] || die "DEV_ENV_AUTOMATIONS_DIR does not exist: $DEV_ENV_AUTOMATIONS_DIR"
    printf '%s' "$DEV_ENV_AUTOMATIONS_DIR"
    return 0
  fi

  local pwd_candidate script_candidate home_candidate
  pwd_candidate="${PWD}/dev-containers/automations"
  script_candidate="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../dev-containers/automations"
  home_candidate="${HOME}/repo/dev-env/dev-containers/automations"

  for d in "$pwd_candidate" "$script_candidate" "$home_candidate"; do
    if [[ -d "$d" ]]; then
      printf '%s' "$d"
      return 0
    fi
  done

  return 1
}

ensure_network_and_image() {
  docker network inspect "$NETWORK" >/dev/null 2>&1 || die "Network '$NETWORK' not found. Start vpn-gateway first."
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "Image '$IMAGE' not found. Build it first: docker build -t $IMAGE <path>"
  docker image inspect "$NET_IMAGE" >/dev/null 2>&1 || die "Image '$NET_IMAGE' not found. Build it first: docker build -t $NET_IMAGE <path-to-dev-containers/net-sidecar>"
}

pick_port() {
  local p=$PORT_BASE
  while [[ $p -le $PORT_MAX ]]; do
    if ! nc -z 127.0.0.1 "$p" >/dev/null 2>&1; then
      echo "$p"; return 0
    fi
    p=$((p+1))
  done
  return 1
}

ensure_port_number() {
  local p="$1" field="$2"
  [[ "$p" =~ ^[0-9]+$ ]] || die "Invalid ${field}: '${p}' (must be numeric)"
  (( p >= 1 && p <= 65535 )) || die "Invalid ${field}: '${p}' (must be 1-65535)"
}

port_fwd_name() {
  local env_name="$1" host_port="$2" container_port="$3"
  echo "${env_name}-pf-${host_port}-${container_port}"
}

ensure_port_forward_image() {
  docker image inspect "$PORT_FWD_IMAGE" >/dev/null 2>&1 || docker pull "$PORT_FWD_IMAGE" >/dev/null
}

allow_sidecar_port() {
  local env_name="$1" target_port="$2"
  docker exec "${env_name}-net" sh -lc \
    "iptables -C INPUT -p tcp --dport ${target_port} -j ACCEPT >/dev/null 2>&1 || iptables -I INPUT 1 -p tcp --dport ${target_port} -j ACCEPT"
}

deny_sidecar_port() {
  local env_name="$1" target_port="$2"
  docker exec "${env_name}-net" sh -lc \
    "iptables -D INPUT -p tcp --dport ${target_port} -j ACCEPT >/dev/null 2>&1 || true"
}

port_forward_ids_for_env() {
  local env_name="$1"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_PORT" \
    --filter "label=dev-env.name=$env_name" \
    --format '{{.ID}}'
}

service_canonical() {
  local service="$1"
  case "$service" in
    postgres) echo "postgres" ;;
    redis) echo "redis" ;;
    mongodb|mongo) echo "mongo" ;;
    elasticsearch|es) echo "elasticsearch" ;;
    *)
      die "Unsupported service '${service}'. Supported: postgres, redis, mongo|mongodb, elasticsearch|es"
      ;;
  esac
}

validate_service_instance() {
  local instance="$1"
  [[ "$instance" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Invalid service instance '${instance}'. Use lowercase letters, digits, hyphen (max 32 chars)."
}

service_instance_value() {
  local instance="${1:-default}"
  validate_service_instance "$instance"
  echo "$instance"
}

service_container_name() {
  local env_name="$1" service="$2" instance="${3:-default}"
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  if [[ "$instance" == "default" ]]; then
    echo "${env_name}-svc-${service}"
  else
    echo "${env_name}-svc-${service}-${instance}"
  fi
}

service_volume_name() {
  local env_name="$1" service="$2" instance="${3:-default}"
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  if [[ "$instance" == "default" ]]; then
    echo "${env_name}-svc-${service}-data"
  else
    echo "${env_name}-svc-${service}-${instance}-data"
  fi
}

service_default_port() {
  local service="$1"
  service="$(service_canonical "$service")"
  case "$service" in
    postgres) echo "5432" ;;
    redis) echo "6379" ;;
    mongo) echo "27017" ;;
    elasticsearch) echo "9200" ;;
  esac
}

service_aliases() {
  local service="$1"
  service="$(service_canonical "$service")"
  case "$service" in
    postgres) echo "postgres" ;;
    redis) echo "redis" ;;
    mongo) echo "mongo, mongodb" ;;
    elasticsearch) echo "elasticsearch, es" ;;
  esac
}

service_catalog() {
  printf "%-14s %-20s %-10s %s\n" "SERVICE" "ALIASES" "BASE_PORT" "DEFAULTS"
  printf "%-14s %-20s %-10s %s\n" "postgres" "postgres" "5432" "user=dev db=app pass=dev"
  printf "%-14s %-20s %-10s %s\n" "redis" "redis" "6379" "optional password"
  printf "%-14s %-20s %-10s %s\n" "mongo" "mongo, mongodb" "27017" "optional root auth"
  printf "%-14s %-20s %-10s %s\n" "elasticsearch" "elasticsearch, es" "9200" "xpack.security=false"
  cat <<'EOT'

Instances:
  You can run multiple instances per service:
    dev-env svc-new <name> <service> [instance]
  If port is not specified, the next free port is auto-selected from BASE_PORT upward.

Override defaults with env vars before `svc-new`:
  DEV_ENV_SVC_PORT
  DEV_ENV_POSTGRES_VERSION DEV_ENV_POSTGRES_USER DEV_ENV_POSTGRES_PASSWORD DEV_ENV_POSTGRES_DB
  DEV_ENV_REDIS_VERSION DEV_ENV_REDIS_PASSWORD
  DEV_ENV_MONGO_VERSION DEV_ENV_MONGO_INITDB_ROOT_USERNAME DEV_ENV_MONGO_INITDB_ROOT_PASSWORD
  DEV_ENV_ELASTIC_VERSION DEV_ENV_ELASTIC_JAVA_OPTS

Interactive setup:
  dev-env svc-new-custom <name> <service> [instance]   (alias: svc-start-custom)
EOT
}

prompt_default() {
  local label="$1" default="${2:-}" value
  if [[ -n "$default" ]]; then
    read -r -p "${label} [${default}]: " value
    printf '%s' "${value:-$default}"
  else
    read -r -p "${label}: " value
    printf '%s' "$value"
  fi
}

prompt_secret_default() {
  local label="$1" default="${2:-}" value
  if [[ -n "$default" ]]; then
    read -r -s -p "${label} [hidden, Enter keeps current]: " value
    echo >&2
    printf '%s' "${value:-$default}"
  else
    read -r -s -p "${label} [hidden]: " value
    echo >&2
    printf '%s' "$value"
  fi
}

docker_env_value() {
  local container="$1" key="$2"
  docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null \
    | awk -v k="$key" '
      index($0, k "=") == 1 { print substr($0, length(k) + 2); found=1; exit }
      END { if (!found) exit 1 }
    '
}

service_ids_for_env() {
  local env_name="$1"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_SVC" \
    --filter "label=dev-env.name=$env_name" \
    --format '{{.ID}}'
}

service_port_for_container() {
  local svc_name="$1" service="$2"
  local svc_port
  svc_port="$(docker inspect -f '{{ index .Config.Labels "dev-env.port" }}' "$svc_name" 2>/dev/null || true)"
  if [[ -z "$svc_port" ]]; then
    svc_port="$(service_default_port "$service")"
  fi
  printf '%s' "$svc_port"
}

service_port_in_use() {
  local env_name="$1" target_port="$2"
  local svc_ids id current_port current_service
  svc_ids="$(service_ids_for_env "$env_name")"
  [[ -n "$svc_ids" ]] || return 1

  for id in $svc_ids; do
    current_port="$(docker inspect -f '{{ index .Config.Labels "dev-env.port" }}' "$id" 2>/dev/null || true)"
    current_service="$(docker inspect -f '{{ index .Config.Labels "dev-env.service" }}' "$id" 2>/dev/null || true)"
    if [[ -z "$current_port" && -n "$current_service" ]]; then
      current_port="$(service_default_port "$current_service")"
    fi
    [[ "$current_port" == "$target_port" ]] && return 0
  done

  return 1
}

service_pick_port() {
  local env_name="$1" service="$2" requested_port="${3:-}"
  local candidate

  if [[ -n "$requested_port" ]]; then
    ensure_port_number "$requested_port" "service-port"
    service_port_in_use "$env_name" "$requested_port" && die "Service port ${requested_port} is already in use in ${env_name}."
    printf '%s' "$requested_port"
    return 0
  fi

  candidate="$(service_default_port "$service")"
  while service_port_in_use "$env_name" "$candidate"; do
    candidate=$((candidate + 1))
    (( candidate <= 65535 )) || die "No free service ports left for ${service} in ${env_name}."
  done
  printf '%s' "$candidate"
}

service_collect_custom_env() {
  local env_name="$1" service="$2" instance="$3"
  local suggested_port svc_port
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  SVC_CUSTOM_EXPORTS=()

  suggested_port="$(service_pick_port "$env_name" "$service" "${DEV_ENV_SVC_PORT:-}")"
  svc_port="$(prompt_default "Internal port for ${service}/${instance}" "$suggested_port")"
  SVC_CUSTOM_EXPORTS+=("DEV_ENV_SVC_PORT=${svc_port}")

  case "$service" in
    postgres)
      local pg_ver pg_user pg_pass pg_db
      pg_ver="$(prompt_default "Postgres version" "${DEV_ENV_POSTGRES_VERSION:-16}")"
      pg_user="$(prompt_default "Postgres user" "${DEV_ENV_POSTGRES_USER:-dev}")"
      pg_pass="$(prompt_secret_default "Postgres password" "${DEV_ENV_POSTGRES_PASSWORD:-dev}")"
      pg_db="$(prompt_default "Postgres database" "${DEV_ENV_POSTGRES_DB:-app}")"
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_POSTGRES_VERSION=${pg_ver}")
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_POSTGRES_USER=${pg_user}")
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_POSTGRES_PASSWORD=${pg_pass}")
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_POSTGRES_DB=${pg_db}")
      ;;
    redis)
      local redis_ver redis_pass
      redis_ver="$(prompt_default "Redis version" "${DEV_ENV_REDIS_VERSION:-7-alpine}")"
      redis_pass="$(prompt_secret_default "Redis password (empty = no auth)" "${DEV_ENV_REDIS_PASSWORD:-}")"
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_REDIS_VERSION=${redis_ver}")
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_REDIS_PASSWORD=${redis_pass}")
      ;;
    mongo)
      local mongo_ver mongo_user mongo_pass
      mongo_ver="$(prompt_default "Mongo version" "${DEV_ENV_MONGO_VERSION:-7}")"
      mongo_user="$(prompt_default "Mongo root username (empty = no auth)" "${DEV_ENV_MONGO_INITDB_ROOT_USERNAME:-}")"
      mongo_pass=""
      if [[ -n "$mongo_user" ]]; then
        mongo_pass="$(prompt_secret_default "Mongo root password" "${DEV_ENV_MONGO_INITDB_ROOT_PASSWORD:-}")"
        [[ -n "$mongo_pass" ]] || die "Mongo root password cannot be empty when username is set."
      fi
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_MONGO_VERSION=${mongo_ver}")
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_MONGO_INITDB_ROOT_USERNAME=${mongo_user}")
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_MONGO_INITDB_ROOT_PASSWORD=${mongo_pass}")
      ;;
    elasticsearch)
      local es_ver es_java_opts
      es_ver="$(prompt_default "Elasticsearch version" "${DEV_ENV_ELASTIC_VERSION:-8.13.4}")"
      es_java_opts="$(prompt_default "Elasticsearch ES_JAVA_OPTS" "${DEV_ENV_ELASTIC_JAVA_OPTS:--Xms512m -Xmx512m}")"
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_ELASTIC_VERSION=${es_ver}")
      SVC_CUSTOM_EXPORTS+=("DEV_ENV_ELASTIC_JAVA_OPTS=${es_java_opts}")
      ;;
  esac
}

port_forward_host_ports_for_target() {
  local env_name="$1" target_port="$2"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_PORT" \
    --filter "label=dev-env.name=$env_name" \
    --filter "label=dev-env.target_port=$target_port" \
    --format '{{.Label "dev-env.host_port"}}'
}

service_info() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local canonical svc_name port status host_ports host_line

  canonical="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$canonical" "$instance")"

  if docker inspect "$svc_name" >/dev/null 2>&1; then
    status="$(docker inspect -f '{{.State.Status}}' "$svc_name" 2>/dev/null || echo "unknown")"
    port="$(service_port_for_container "$svc_name" "$canonical")"
  else
    status="not-created"
    port="$(service_default_port "$canonical")"
  fi

  host_ports="$(port_forward_host_ports_for_target "$env_name" "$port")"
  if [[ -n "$host_ports" ]]; then
    host_line="$(echo "$host_ports" | awk 'NF{printf "%s127.0.0.1:%s", (sep? ", ":""), $0; sep=1} END{if(!sep) printf "not exposed"}')"
  else
    host_line="not exposed (use: dev-env port-open ${env_name} ${port})"
  fi

  echo "Service: ${canonical} (requested: ${service})"
  echo "Instance: ${instance}"
  echo "Container: ${svc_name}"
  echo "Aliases: $(service_aliases "$canonical")"
  echo "Status: ${status}"
  echo "In-container endpoint: 127.0.0.1:${port}"
  echo "Host endpoint(s): ${host_line}"

  case "$canonical" in
    postgres)
      local pg_user pg_pass pg_db v
      pg_user="${DEV_ENV_POSTGRES_USER:-dev}"
      pg_pass="${DEV_ENV_POSTGRES_PASSWORD:-dev}"
      pg_db="${DEV_ENV_POSTGRES_DB:-app}"

      if docker inspect "$svc_name" >/dev/null 2>&1; then
        v="$(docker_env_value "$svc_name" "POSTGRES_USER" 2>/dev/null || true)"; [[ -n "$v" ]] && pg_user="$v"
        v="$(docker_env_value "$svc_name" "POSTGRES_PASSWORD" 2>/dev/null || true)"; [[ -n "$v" ]] && pg_pass="$v"
        v="$(docker_env_value "$svc_name" "POSTGRES_DB" 2>/dev/null || true)"; [[ -n "$v" ]] && pg_db="$v"
      fi

      echo "Credentials: user=${pg_user} password=${pg_pass} db=${pg_db}"
      echo "URI (inside ${env_name}): postgres://${pg_user}:${pg_pass}@127.0.0.1:${port}/${pg_db}"
      ;;
    redis)
      local redis_pass v
      redis_pass="${DEV_ENV_REDIS_PASSWORD:-}"
      if docker inspect "$svc_name" >/dev/null 2>&1; then
        v="$(docker_env_value "$svc_name" "REDIS_PASSWORD" 2>/dev/null || true)"; [[ -n "$v" ]] && redis_pass="$v"
      fi
      if [[ -n "$redis_pass" ]]; then
        echo "Credentials: password=${redis_pass}"
        echo "URI (inside ${env_name}): redis://:${redis_pass}@127.0.0.1:${port}"
      else
        echo "Credentials: none"
        echo "URI (inside ${env_name}): redis://127.0.0.1:${port}"
      fi
      ;;
    mongo)
      local mongo_user mongo_pass v
      mongo_user="${DEV_ENV_MONGO_INITDB_ROOT_USERNAME:-}"
      mongo_pass="${DEV_ENV_MONGO_INITDB_ROOT_PASSWORD:-}"
      if docker inspect "$svc_name" >/dev/null 2>&1; then
        v="$(docker_env_value "$svc_name" "MONGO_INITDB_ROOT_USERNAME" 2>/dev/null || true)"; [[ -n "$v" ]] && mongo_user="$v"
        v="$(docker_env_value "$svc_name" "MONGO_INITDB_ROOT_PASSWORD" 2>/dev/null || true)"; [[ -n "$v" ]] && mongo_pass="$v"
      fi
      if [[ -n "$mongo_user" ]]; then
        echo "Credentials: user=${mongo_user} password=${mongo_pass}"
        echo "URI (inside ${env_name}): mongodb://${mongo_user}:${mongo_pass}@127.0.0.1:${port}/admin"
      else
        echo "Credentials: none"
        echo "URI (inside ${env_name}): mongodb://127.0.0.1:${port}"
      fi
      ;;
    elasticsearch)
      echo "Credentials: none (xpack security disabled)"
      echo "URL (inside ${env_name}): http://127.0.0.1:${port}"
      ;;
  esac
}

service_exists() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local svc_name
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"
  docker inspect "$svc_name" >/dev/null 2>&1
}

service_resolve_ref() {
  local env_name="$1" ref="$2"
  local role resolved_env resolved_service resolved_instance

  if docker inspect "$ref" >/dev/null 2>&1; then
    role="$(docker inspect -f '{{ index .Config.Labels "dev-env.role" }}' "$ref" 2>/dev/null || true)"
    resolved_env="$(docker inspect -f '{{ index .Config.Labels "dev-env.name" }}' "$ref" 2>/dev/null || true)"
    resolved_service="$(docker inspect -f '{{ index .Config.Labels "dev-env.service" }}' "$ref" 2>/dev/null || true)"
    resolved_instance="$(docker inspect -f '{{ index .Config.Labels "dev-env.instance" }}' "$ref" 2>/dev/null || true)"

    [[ "$role" == "$ROLE_SVC" ]] || die "Container '${ref}' is not a managed service."
    [[ "$resolved_env" == "$env_name" ]] || die "Service container '${ref}' belongs to env '${resolved_env}', not '${env_name}'."
    [[ -n "$resolved_service" ]] || die "Service container '${ref}' is missing service metadata."
    [[ -n "$resolved_instance" ]] || resolved_instance="default"

    SVC_RESOLVED_SERVICE="$resolved_service"
    SVC_RESOLVED_INSTANCE="$resolved_instance"
    return 0
  fi

  SVC_RESOLVED_SERVICE="$(service_canonical "$ref")"
  SVC_RESOLVED_INSTANCE="default"
}

service_spec() {
  local env_name="$1" service="$2" instance="$3" svc_port="$4"
  local transport_port
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  ensure_port_number "$svc_port" "service-port"
  SVC_IMAGE=""
  SVC_VOL_NAME="$(service_volume_name "$env_name" "$service" "$instance")"
  SVC_VOL_MOUNT=""
  SVC_ENV_ARGS=()
  SVC_CMD_ARGS=()
  SVC_RUN_ARGS=()

  case "$service" in
    postgres)
      local pg_ver pg_user pg_pass pg_db
      pg_ver="${DEV_ENV_POSTGRES_VERSION:-16}"
      pg_user="${DEV_ENV_POSTGRES_USER:-dev}"
      pg_pass="${DEV_ENV_POSTGRES_PASSWORD:-dev}"
      pg_db="${DEV_ENV_POSTGRES_DB:-app}"
      SVC_IMAGE="postgres:${pg_ver}"
      SVC_VOL_MOUNT="/var/lib/postgresql/data"
      SVC_ENV_ARGS=(-e "POSTGRES_USER=${pg_user}" -e "POSTGRES_PASSWORD=${pg_pass}" -e "POSTGRES_DB=${pg_db}")
      SVC_CMD_ARGS=("postgres" "-p" "$svc_port")
      ;;
    redis)
      local redis_ver redis_pass
      redis_ver="${DEV_ENV_REDIS_VERSION:-7-alpine}"
      redis_pass="${DEV_ENV_REDIS_PASSWORD:-}"
      SVC_IMAGE="redis:${redis_ver}"
      SVC_VOL_MOUNT="/data"
      if [[ -n "$redis_pass" ]]; then
        SVC_ENV_ARGS=(-e "REDIS_PASSWORD=${redis_pass}" -e "REDIS_PORT=${svc_port}")
        SVC_CMD_ARGS=("sh" "-lc" 'exec redis-server --appendonly yes --port "$REDIS_PORT" --requirepass "$REDIS_PASSWORD"')
      else
        SVC_CMD_ARGS=("redis-server" "--appendonly" "yes" "--port" "$svc_port")
      fi
      ;;
    mongo)
      local mongo_ver mongo_user mongo_pass
      mongo_ver="${DEV_ENV_MONGO_VERSION:-7}"
      mongo_user="${DEV_ENV_MONGO_INITDB_ROOT_USERNAME:-}"
      mongo_pass="${DEV_ENV_MONGO_INITDB_ROOT_PASSWORD:-}"
      if [[ -n "$mongo_user" && -z "$mongo_pass" ]]; then
        die "Mongo root password is required when DEV_ENV_MONGO_INITDB_ROOT_USERNAME is set."
      fi
      if [[ -z "$mongo_user" && -n "$mongo_pass" ]]; then
        die "Mongo root username is required when DEV_ENV_MONGO_INITDB_ROOT_PASSWORD is set."
      fi
      SVC_IMAGE="mongo:${mongo_ver}"
      SVC_VOL_MOUNT="/data/db"
      if [[ -n "$mongo_user" ]]; then
        SVC_ENV_ARGS=(-e "MONGO_INITDB_ROOT_USERNAME=${mongo_user}" -e "MONGO_INITDB_ROOT_PASSWORD=${mongo_pass}")
      fi
      SVC_CMD_ARGS=("mongod" "--bind_ip_all" "--port" "$svc_port")
      ;;
    elasticsearch)
      local es_ver es_java_opts
      es_ver="${DEV_ENV_ELASTIC_VERSION:-8.13.4}"
      es_java_opts="${DEV_ENV_ELASTIC_JAVA_OPTS:--Xms512m -Xmx512m}"
      transport_port=$((svc_port + 100))
      if (( transport_port > 65535 )); then
        transport_port=$((svc_port + 1))
      fi
      (( transport_port <= 65535 )) || die "Could not allocate elasticsearch transport port for service-port ${svc_port}."

      SVC_IMAGE="docker.elastic.co/elasticsearch/elasticsearch:${es_ver}"
      SVC_VOL_MOUNT="/usr/share/elasticsearch/data"
      SVC_ENV_ARGS=(-e "discovery.type=single-node" -e "xpack.security.enabled=false" -e "ES_JAVA_OPTS=${es_java_opts}" -e "http.port=${svc_port}" -e "transport.port=${transport_port}")
      SVC_RUN_ARGS=(--ulimit "memlock=-1:-1")
      ;;
  esac
}

service_ensure_volume() {
  local env_name="$1" service="$2" instance="$3"
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  SVC_VOL_NAME="$(service_volume_name "$env_name" "$service" "$instance")"
  docker volume inspect "$SVC_VOL_NAME" >/dev/null 2>&1 || \
    docker volume create \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_SVC" \
      --label "dev-env.name=$env_name" \
      --label "dev-env.service=$service" \
      --label "dev-env.instance=$instance" \
      "$SVC_VOL_NAME" >/dev/null
}

service_start_one() {
  local env_name="$1" service="$2" instance="${3:-default}" requested_port="${4:-}"
  local svc_name svc_port
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"

  docker inspect "${env_name}-net" >/dev/null 2>&1 || die "No such sidecar: ${env_name}-net"
  docker start "${env_name}-net" >/dev/null 2>&1 || true
  wait_for_healthy "${env_name}-net" || die "Sidecar '${env_name}-net' did not become healthy."

  if docker inspect "$svc_name" >/dev/null 2>&1; then
    docker start "$svc_name" >/dev/null 2>&1 || true
    SVC_LAST_ACTION="started"
    SVC_LAST_PORT="$(service_port_for_container "$svc_name" "$service")"
    return 0
  fi

  svc_port="$(service_pick_port "$env_name" "$service" "$requested_port")"
  service_spec "$env_name" "$service" "$instance" "$svc_port"
  service_ensure_volume "$env_name" "$service" "$instance"

  local vol_args=()
  if [[ -n "$SVC_VOL_NAME" && -n "$SVC_VOL_MOUNT" ]]; then
    vol_args=(-v "${SVC_VOL_NAME}:${SVC_VOL_MOUNT}")
  fi

  local docker_args=(
    -d
    --name "$svc_name"
    --label "$LABEL_KEY=$LABEL_VAL"
    --label "$ROLE_KEY=$ROLE_SVC"
    --label "dev-env.name=$env_name"
    --label "dev-env.service=$service"
    --label "dev-env.instance=$instance"
    --label "dev-env.port=$svc_port"
    --restart unless-stopped
    --network "container:${env_name}-net"
  )
  if [[ ${#SVC_RUN_ARGS[@]} -gt 0 ]]; then
    docker_args+=("${SVC_RUN_ARGS[@]}")
  fi
  if [[ ${#SVC_ENV_ARGS[@]} -gt 0 ]]; then
    docker_args+=("${SVC_ENV_ARGS[@]}")
  fi
  if [[ ${#vol_args[@]} -gt 0 ]]; then
    docker_args+=("${vol_args[@]}")
  fi
  docker_args+=("$SVC_IMAGE")
  if [[ ${#SVC_CMD_ARGS[@]} -gt 0 ]]; then
    docker_args+=("${SVC_CMD_ARGS[@]}")
  fi

  docker run "${docker_args[@]}" >/dev/null
  SVC_LAST_ACTION="created"
  SVC_LAST_PORT="$svc_port"
}

service_stop_one() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local svc_name
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"
  docker inspect "$svc_name" >/dev/null 2>&1 || die "No such service container: $svc_name"
  docker stop "$svc_name" >/dev/null 2>&1 || true
}

service_rm_one() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local svc_name svc_vol_name
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"
  svc_vol_name="$(service_volume_name "$env_name" "$service" "$instance")"

  docker inspect "$svc_name" >/dev/null 2>&1 || die "No such service container: $svc_name"
  docker rm -f "$svc_name" >/dev/null
  docker volume rm "$svc_vol_name" >/dev/null 2>&1 || true
}

service_start_all_for_env() {
  local env_name="$1"
  local svc_ids
  svc_ids="$(service_ids_for_env "$env_name")"
  if [[ -n "$svc_ids" ]]; then
    docker start $svc_ids >/dev/null 2>&1 || true
  fi
}

service_stop_all_for_env() {
  local env_name="$1"
  local svc_ids
  svc_ids="$(service_ids_for_env "$env_name")"
  if [[ -n "$svc_ids" ]]; then
    docker stop $svc_ids >/dev/null 2>&1 || true
  fi
}

service_rm_all_for_env() {
  local env_name="$1"
  local svc_ids svc_vol_ids

  svc_ids="$(service_ids_for_env "$env_name")"
  if [[ -n "$svc_ids" ]]; then
    docker rm -f $svc_ids >/dev/null 2>&1 || true
  fi

  svc_vol_ids="$(docker volume ls -q \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_SVC" \
    --filter "label=dev-env.name=$env_name")"
  if [[ -n "$svc_vol_ids" ]]; then
    docker volume rm $svc_vol_ids >/dev/null 2>&1 || true
  fi
}

port_target_ports_for_env() {
  local env_name="$1"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_PORT" \
    --filter "label=dev-env.name=$env_name" \
    --format '{{.Label "dev-env.target_port"}}'
}

allow_sidecar_ports_for_env() {
  local env_name="$1"
  local mapped_ports
  mapped_ports="$(port_target_ports_for_env "$env_name")"
  if [[ -n "$mapped_ports" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      allow_sidecar_port "$env_name" "$p"
    done <<< "$mapped_ports"
  fi
}

wait_for_healthy() {
  local container="$1"
  for _ in {1..80}; do
    local status
    status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container" 2>/dev/null || true)"
    if [[ "$status" == "healthy" ]]; then
      return 0
    fi
    if [[ "$status" == "unhealthy" ]]; then
      return 1
    fi
    sleep 0.25
  done
  return 1
}

remove_ssh_config_host() {
  local host="$1"
  [[ -f "$SSHCFG" ]] || return 0
  awk -v h="$host" '
    BEGIN{skip=0}
    $1=="Host" && $2==h {skip=1; next}
    $1=="Host" && skip==1 {skip=0}
    skip==0 {print}
  ' "$SSHCFG" > "${SSHCFG}.tmp"
  mv "${SSHCFG}.tmp" "$SSHCFG"
}

remove_known_host_entry() {
  local host="$1" port="$2"
  mkdir -p "${HOME}/.ssh"
  touch "$KNOWN_HOSTS_DEV"
  chmod 600 "$KNOWN_HOSTS_DEV"
  ssh-keygen -R "[${host}]:${port}" -f "$KNOWN_HOSTS_DEV" >/dev/null 2>&1 || true
}

set_ssh_config_host() {
  local host="$1" port="$2" user="$3"

  touch "$SSHCFG"
  chmod 600 "$SSHCFG"

  # remove old block if exists
  remove_ssh_config_host "$host"
  # avoid stale key mismatch when a recreated env reuses the same local port
  remove_known_host_entry "127.0.0.1" "$port"

  cat >> "$SSHCFG" <<EOCFG

Host ${host}
  HostName 127.0.0.1
  Port ${port}
  User ${user}
  IdentityFile ${KEY_PRIV}
  IdentitiesOnly yes
  ForwardAgent yes
  UserKnownHostsFile ~/.ssh/known_hosts_dev_env
  StrictHostKeyChecking accept-new

EOCFG
}

validate_name_and_user() {
  local n="$1"
  [[ "$n" =~ ^[a-z][a-z0-9]{0,31}$ ]] || die "Invalid name '$n'. Must match: ^[a-z][a-z0-9]{0,31}$ (example: dev1, alice2)."
}

case "$cmd" in
  help|-h|--help|"")
    usage
    ;;

  list)
    printf "%-20s %-8s %-28s %s\n" "NAME" "STATE" "STATUS" "IMAGE"
    docker ps -a --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --format "{{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Label \"$ROLE_KEY\"}}" \
      | awk -F '\t' 'BEGIN{OFS="\t"} {
          if ($4 == "net" || $4 == "port" || $4 == "svc" || $1 ~ /-net$/) next;
          state = "stopped";
          if ($2 ~ /^Up( |$)/ || $2 ~ /^Restarting( |$)/) state = "active";
          printf "%-20s %-8s %-28s %s\n", $1, state, $2, $3
        }'
    ;;

  new)
    [[ -z "$name" ]] && die "Usage: dev-env new <name>"
    validate_name_and_user "$name"
    ensure_network_and_image
    ensure_ssh_key

    docker inspect "$name" >/dev/null 2>&1 && die "Container '$name' already exists."

    USER_NAME="$name"
    NET_NAME="${name}-net"
    HOST_GIT_NAME="$(git config --global --get user.name 2>/dev/null || true)"
    HOST_GIT_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"
    PORT="$(pick_port)" || die "No free port in ${PORT_BASE}-${PORT_MAX}"

    HOME_VOL="${name}-home"
    REPO_VOL="${name}-repo"
    created_home_vol="false"
    created_repo_vol="false"
    created_net="false"
    created_dev="false"

    cleanup_partial_new() {
      local code=$?
      if [[ $code -eq 0 ]]; then
        return 0
      fi

      [[ "$created_dev" == "true" ]] && docker rm -f "$name" >/dev/null 2>&1 || true
      [[ "$created_net" == "true" ]] && docker rm -f "$NET_NAME" >/dev/null 2>&1 || true
      [[ "$created_home_vol" == "true" ]] && docker volume rm "$HOME_VOL" >/dev/null 2>&1 || true
      [[ "$created_repo_vol" == "true" ]] && docker volume rm "$REPO_VOL" >/dev/null 2>&1 || true
    }
    trap cleanup_partial_new EXIT

    docker inspect "$NET_NAME" >/dev/null 2>&1 && die "Sidecar '$NET_NAME' already exists."

    docker volume create "$HOME_VOL" >/dev/null
    created_home_vol="true"
    docker volume create "$REPO_VOL" >/dev/null
    created_repo_vol="true"

    docker run -d \
      --name "$NET_NAME" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_NET" \
      --restart unless-stopped \
      --network "$NETWORK" \
      --cap-add NET_ADMIN \
      --device /dev/net/tun \
      -e XRAY_HOST="xray" \
      -e XRAY_PORT="1080" \
      -p "127.0.0.1:${PORT}:22" \
      "$NET_IMAGE" >/dev/null
    created_net="true"

    wait_for_healthy "$NET_NAME" || die "Sidecar '$NET_NAME' did not become healthy."

    REPO_MOUNT="/home/${USER_NAME}/repo"
    AUTOMATIONS_HOST_DIR="$(resolve_automations_dir || true)"
    AUTOMATIONS_ARGS=()
    if [[ -n "$AUTOMATIONS_HOST_DIR" ]]; then
      AUTOMATIONS_ARGS=(-v "${AUTOMATIONS_HOST_DIR}:${AUTOMATIONS_MOUNT}:ro")
    fi

    docker run -d \
      --name "$name" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_DEV" \
      --restart unless-stopped \
      --network "container:${NET_NAME}" \
      -e DEV_USER="$USER_NAME" \
      -e REPO_DIR="$REPO_MOUNT" \
      -e GIT_USER_NAME="$HOST_GIT_NAME" \
      -e GIT_USER_EMAIL="$HOST_GIT_EMAIL" \
      -v "${HOME_VOL}:/home/${USER_NAME}" \
      -v "${REPO_VOL}:${REPO_MOUNT}" \
      "${AUTOMATIONS_ARGS[@]}" \
      "$IMAGE" >/dev/null
    created_dev="true"

    for _ in {1..50}; do
      nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 && break
      sleep 0.1
    done
    nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 || die "SSH port ${PORT} did not open for '$name'."

    docker exec -u root "$name" bash -lc "mkdir -p /home/${USER_NAME}/.ssh && chmod 700 /home/${USER_NAME}/.ssh && chown -R ${USER_NAME}:${USER_NAME} /home/${USER_NAME}/.ssh" >/dev/null
    docker cp "$KEY_PUB" "${name}:/home/${USER_NAME}/.ssh/authorized_keys"
    docker exec -u root "$name" bash -lc "chown ${USER_NAME}:${USER_NAME} /home/${USER_NAME}/.ssh/authorized_keys && chmod 600 /home/${USER_NAME}/.ssh/authorized_keys" >/dev/null

    set_ssh_config_host "$name" "$PORT" "$USER_NAME"
    trap - EXIT

    echo "Created: $name"
    echo "  Network sidecar: $NET_NAME"
    echo "  Linux user: $USER_NAME"
    echo "  SSH: dev-env ssh $name   (or: ssh $name)"
    echo "  Repo: /repo -> ${REPO_MOUNT} (volume: ${REPO_VOL})"
    echo "  Home: /home/${USER_NAME} (volume: ${HOME_VOL})"
    if [[ -n "$AUTOMATIONS_HOST_DIR" ]]; then
      echo "  Automations: ${AUTOMATIONS_HOST_DIR} -> ${AUTOMATIONS_MOUNT} (ro)"
    else
      echo "  Automations: not mounted (set DEV_ENV_AUTOMATIONS_DIR or create dev-containers/automations)"
    fi
    if [[ -n "$HOST_GIT_NAME" && -n "$HOST_GIT_EMAIL" ]]; then
      echo "  Git identity: ${HOST_GIT_NAME} <${HOST_GIT_EMAIL}>"
    else
      echo "  Git identity: not set on host (run: git config --global user.name/user.email)"
    fi
    echo "  Port: 127.0.0.1:${PORT}"
    ;;

  rm)
    [[ -z "$name" ]] && die "Usage: dev-env rm <name>"
    validate_name_and_user "$name"

    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    docker rm -f "$name" >/dev/null
    docker rm -f "${name}-net" >/dev/null 2>&1 || true
    service_rm_all_for_env "$name"
    pf_ids="$(port_forward_ids_for_env "$name")"
    if [[ -n "$pf_ids" ]]; then
      docker rm -f $pf_ids >/dev/null 2>&1 || true
    fi

    docker volume rm "${name}-home" >/dev/null 2>&1 || true
    docker volume rm "${name}-repo" >/dev/null 2>&1 || true

    remove_ssh_config_host "$name"

    echo "Removed: $name"
    echo "  Deleted volumes: ${name}-home, ${name}-repo"
    ;;

  ssh)
    [[ -z "$name" ]] && die "Usage: dev-env ssh <name>"
    validate_name_and_user "$name"
    ssh-add --apple-use-keychain ~/.ssh/ghub_key >/dev/null 2>&1 || true
    exec ssh -A "$name"
    ;;

  start)
    [[ -z "$name" ]] && die "Usage: dev-env start <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"

    if docker inspect "${name}-net" >/dev/null 2>&1; then
      docker start "${name}-net" >/dev/null 2>&1 || true
      wait_for_healthy "${name}-net" || die "Sidecar '${name}-net' did not become healthy."
    fi

    docker start "$name" >/dev/null 2>&1 || true
    service_start_all_for_env "$name"

    pf_ids="$(port_forward_ids_for_env "$name")"
    if [[ -n "$pf_ids" ]]; then
      docker start $pf_ids >/dev/null 2>&1 || true
    fi

    if docker inspect "${name}-net" >/dev/null 2>&1; then
      allow_sidecar_ports_for_env "$name"
      echo "Started: $name (and ${name}-net)"
    else
      echo "Started: $name"
    fi
    ;;

  stop)
    [[ -z "$name" ]] && die "Usage: dev-env stop <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"

    pf_ids="$(port_forward_ids_for_env "$name")"
    if [[ -n "$pf_ids" ]]; then
      docker stop $pf_ids >/dev/null 2>&1 || true
    fi

    service_stop_all_for_env "$name"
    docker stop "$name" >/dev/null 2>&1 || true
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      docker stop "${name}-net" >/dev/null 2>&1 || true
      echo "Stopped: $name (and ${name}-net)"
    else
      echo "Stopped: $name"
    fi
    ;;

  restart)
    [[ -z "$name" ]] && die "Usage: dev-env restart <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      docker restart "${name}-net" >/dev/null
    fi
    docker restart "$name" >/dev/null
    service_start_all_for_env "$name"
    allow_sidecar_ports_for_env "$name"
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      echo "Restarted: $name (and ${name}-net)"
    else
      echo "Restarted: $name"
    fi
    ;;

  cd)
    [[ -z "$name" ]] && die "Usage: dev-env cd <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    exec docker exec -it -u "$name" "$name" bash -lc 'cd /repo && exec bash'
    ;;

  svc-new|svc-start)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env svc-new <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    service_start_one "$name" "$svc_service" "$svc_instance" "${DEV_ENV_SVC_PORT:-}"
    echo "Service ${SVC_LAST_ACTION}: ${name}/${svc_service}/${svc_instance} (port ${SVC_LAST_PORT})"
    if [[ "$cmd" == "svc-start" ]]; then
      echo "  Note: svc-start is an alias of svc-new."
    fi
    ;;

  svc-new-custom|svc-start-custom)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env svc-new-custom <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    [[ -t 0 ]] || die "svc-new-custom requires an interactive terminal."
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    if service_exists "$name" "$svc_service" "$svc_instance"; then
      svc_name="$(service_container_name "$name" "$svc_service" "$svc_instance")"
      die "Service already exists: ${svc_name}. Recreate it to change config: dev-env svc-rm ${name} ${svc_service} ${svc_instance} && dev-env svc-new-custom ${name} ${svc_service} ${svc_instance}"
    fi
    service_collect_custom_env "$name" "$svc_service" "$svc_instance"
    (
      for kv in "${SVC_CUSTOM_EXPORTS[@]}"; do
        export "$kv"
      done
      service_start_one "$name" "$svc_service" "$svc_instance" "${DEV_ENV_SVC_PORT:-}"
    )
    echo "Service created with custom config: ${name}/${svc_service}/${svc_instance}"
    service_info "$name" "$svc_service" "$svc_instance"
    if [[ "$cmd" == "svc-start-custom" ]]; then
      echo "  Note: svc-start-custom is an alias of svc-new-custom."
    fi
    ;;

  svc-stop)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env svc-stop <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    service_stop_one "$name" "$svc_service" "$svc_instance"
    echo "Service stopped: ${name}/${svc_service}/${svc_instance}"
    ;;

  svc-rm)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env svc-rm <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    service_rm_one "$name" "$svc_service" "$svc_instance"
    echo "Service removed: ${name}/${svc_service}/${svc_instance}"
    ;;

  svc-list)
    if [[ $# -gt 2 ]]; then
      die "Usage: dev-env svc-list [name]"
    fi
    echo -e "NAME\tSTATE\tSTATUS\tENV\tSERVICE\tINSTANCE\tPORT\tIMAGE"
    if [[ $# -eq 2 ]]; then
      validate_name_and_user "$name"
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_SVC" \
        --filter "label=dev-env.name=$name" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"dev-env.name\"}}\t{{.Label \"dev-env.service\"}}\t{{.Label \"dev-env.instance\"}}\t{{.Label \"dev-env.port\"}}\t{{.Image}}" \
        | awk -F '\t' 'BEGIN{OFS="\t"} {
            state = "stopped";
            if ($2 ~ /^Up( |$)/ || $2 ~ /^Restarting( |$)/) state = "active";
            instance = $5;
            if (instance == "") instance = "default";
            port = $6;
            if (port == "") {
              if ($4 == "postgres") port = "5432";
              else if ($4 == "redis") port = "6379";
              else if ($4 == "mongo") port = "27017";
              else if ($4 == "elasticsearch") port = "9200";
            }
            print $1, state, $2, $3, $4, instance, port, $7
          }'
    else
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_SVC" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"dev-env.name\"}}\t{{.Label \"dev-env.service\"}}\t{{.Label \"dev-env.instance\"}}\t{{.Label \"dev-env.port\"}}\t{{.Image}}" \
        | awk -F '\t' 'BEGIN{OFS="\t"} {
            state = "stopped";
            if ($2 ~ /^Up( |$)/ || $2 ~ /^Restarting( |$)/) state = "active";
            instance = $5;
            if (instance == "") instance = "default";
            port = $6;
            if (port == "") {
              if ($4 == "postgres") port = "5432";
              else if ($4 == "redis") port = "6379";
              else if ($4 == "mongo") port = "27017";
              else if ($4 == "elasticsearch") port = "9200";
            }
            print $1, state, $2, $3, $4, instance, port, $7
          }'
    fi
    ;;

  svc-catalog)
    [[ $# -ne 1 ]] && die "Usage: dev-env svc-catalog"
    service_catalog
    ;;

  svc-info)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env svc-info <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    if [[ $# -eq 4 ]]; then
      svc_service="$(service_canonical "$3")"
      svc_instance="$(service_instance_value "$4")"
    else
      service_resolve_ref "$name" "$3"
      svc_service="$SVC_RESOLVED_SERVICE"
      svc_instance="$SVC_RESOLVED_INSTANCE"
    fi
    service_info "$name" "$svc_service" "$svc_instance"
    ;;

  port-open)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env port-open <name> <container-port> [host-port]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    docker inspect "${name}-net" >/dev/null 2>&1 || die "No such sidecar: ${name}-net"

    CONTAINER_PORT="$3"
    HOST_PORT="${4:-$CONTAINER_PORT}"
    ensure_port_number "$CONTAINER_PORT" "container-port"
    ensure_port_number "$HOST_PORT" "host-port"

    PF_NAME="$(port_fwd_name "$name" "$HOST_PORT" "$CONTAINER_PORT")"
    docker inspect "$PF_NAME" >/dev/null 2>&1 && die "Port forward already exists: $PF_NAME"
    nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 && die "Host port ${HOST_PORT} is already in use."

    ensure_port_forward_image
    allow_sidecar_port "$name" "$CONTAINER_PORT"
    docker run -d \
      --name "$PF_NAME" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_PORT" \
      --label "dev-env.name=$name" \
      --label "dev-env.host_port=$HOST_PORT" \
      --label "dev-env.target_port=$CONTAINER_PORT" \
      --restart unless-stopped \
      --network "$NETWORK" \
      -p "127.0.0.1:${HOST_PORT}:${HOST_PORT}" \
      "$PORT_FWD_IMAGE" \
      "TCP-LISTEN:${HOST_PORT},fork,reuseaddr,bind=0.0.0.0" \
      "TCP:${name}-net:${CONTAINER_PORT}" >/dev/null

    for _ in {1..30}; do
      nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 && break
      sleep 0.1
    done
    nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 || die "Port forward did not become ready on 127.0.0.1:${HOST_PORT}"

    echo "Opened: 127.0.0.1:${HOST_PORT} -> ${name}:${CONTAINER_PORT}"
    ;;

  port-close)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: dev-env port-close <name> <container-port> [host-port]"
    validate_name_and_user "$name"

    CONTAINER_PORT="$3"
    HOST_PORT="${4:-$CONTAINER_PORT}"
    ensure_port_number "$CONTAINER_PORT" "container-port"
    ensure_port_number "$HOST_PORT" "host-port"

    PF_NAME="$(port_fwd_name "$name" "$HOST_PORT" "$CONTAINER_PORT")"
    docker inspect "$PF_NAME" >/dev/null 2>&1 || die "No such port forward: $PF_NAME"
    docker rm -f "$PF_NAME" >/dev/null
    remaining_same_target="$(docker ps -a \
      --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --filter "label=$ROLE_KEY=$ROLE_PORT" \
      --filter "label=dev-env.name=$name" \
      --filter "label=dev-env.target_port=$CONTAINER_PORT" \
      --format '{{.ID}}')"
    if [[ -z "$remaining_same_target" ]]; then
      deny_sidecar_port "$name" "$CONTAINER_PORT"
    fi
    echo "Closed: 127.0.0.1:${HOST_PORT} -> ${name}:${CONTAINER_PORT}"
    ;;

  port-list)
    if [[ $# -gt 2 ]]; then
      die "Usage: dev-env port-list [name]"
    fi

    echo -e "NAME\tSTATUS\tENV\tHOST_PORT\tTARGET_PORT"
    if [[ $# -eq 2 ]]; then
      validate_name_and_user "$name"
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_PORT" \
        --filter "label=dev-env.name=$name" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"dev-env.name\"}}\t{{.Label \"dev-env.host_port\"}}\t{{.Label \"dev-env.target_port\"}}"
    else
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_PORT" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"dev-env.name\"}}\t{{.Label \"dev-env.host_port\"}}\t{{.Label \"dev-env.target_port\"}}"
    fi
    ;;

  *)
    usage
    die "Unknown command: $cmd"
    ;;
esac
