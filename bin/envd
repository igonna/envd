#!/usr/bin/env bash
set -euo pipefail

NETWORK="vpn-gateway_inside"
IMAGE="sshdev:24.04"
NET_IMAGE="devnet-sidecar:1"
PORT_FWD_IMAGE="alpine/socat:latest"
PORT_BASE=2223
PORT_MAX=2299

LABEL_KEY="envd.managed"
LABEL_VAL="true"
ROLE_KEY="envd.role"
ROLE_DEV="dev"
ROLE_NET="net"
ROLE_PORT="port"
ROLE_SVC="svc"
AUTOMATIONS_MOUNT="/automations"

SSHCFG="${HOME}/.ssh/config"
KNOWN_HOSTS_FILE="${HOME}/.ssh/known_hosts_envd"
KEY_PRIV="${HOME}/.ssh/id_ed25519"
KEY_PUB="${HOME}/.ssh/id_ed25519.pub"
CLI_NAME="${ENVD_CLI_NAME:-envd}"

usage() {
  cat <<EOT
Usage:
  ${CLI_NAME} [command]

Management Commands:
  ps                           List environments
  run <name>                   Create a new environment
  start <name>                 Start an environment
  stop <name>                  Stop an environment
  restart <name>               Restart an environment
  rm <name>                    Remove an environment
  backup <name> [archive]      Backup environment volumes
  restore <name> <archive>     Restore environment volumes
  exec <name> [cmd...]         Run command / open shell in environment
  doctor [name]                Check environment health and VPN routing

Key Commands:
  key sync <name> [key-path]   Refresh GitHub SSH key inside environment

Service Commands:
  service ls [env]                             List services
  service catalog                              List available service types
  service create <env> <service> [instance]    Add/start a service instance
  service create-custom <env> <service> [instance]
                                                Add a custom service instance
  service start <env> <service> [instance]     Alias of service create
  service stop <env> <service> [instance]
  service rm <env> <service> [instance]
  service inspect <env> <service|container> [instance]

Port Commands:
  port ls [env]                                List port mappings
  port open <env> <container-port> [host-port] Open/map a port
  port close <env> <container-port> [host-port] Close/unmap a port

Legacy aliases still supported: list/new/ssh/cd/sync-key/refresh-key/svc-*/port-*

Naming rule (enforced):
- <name> is also the Linux username inside the container.
- Must match: ^[a-z][a-z0-9]{0,31}$
  Examples: dev1, dev2, alice, alice2
  Not allowed: dev-1, Dev1, dev_1
EOT
}

die(){ echo "ERROR: $*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Missing: $1"; }

need docker
need nc
need ssh
need ssh-keygen
need awk

normalize_cli_args() {
  NORMALIZED_ARGS=("$@")
  if [[ ${#NORMALIZED_ARGS[@]} -eq 0 ]]; then
    NORMALIZED_ARGS=(help)
    return 0
  fi

  case "${NORMALIZED_ARGS[0]}" in
    ps)
      NORMALIZED_ARGS=(list "${NORMALIZED_ARGS[@]:1}")
      ;;
    run)
      NORMALIZED_ARGS=(new "${NORMALIZED_ARGS[@]:1}")
      ;;
    sync-key|refresh-key)
      NORMALIZED_ARGS=(key-sync "${NORMALIZED_ARGS[@]:1}")
      ;;
    key)
      sub="${NORMALIZED_ARGS[1]:-}"
      case "$sub" in
        sync|refresh) NORMALIZED_ARGS=(key-sync "${NORMALIZED_ARGS[@]:2}") ;;
        help|-h|--help|"") NORMALIZED_ARGS=(help) ;;
        *) die "Unknown key subcommand: ${sub}. Use: ${CLI_NAME} key sync <name> [key-path]" ;;
      esac
      ;;
    service)
      sub="${NORMALIZED_ARGS[1]:-}"
      case "$sub" in
        ls) NORMALIZED_ARGS=(svc-list "${NORMALIZED_ARGS[@]:2}") ;;
        catalog) NORMALIZED_ARGS=(svc-catalog "${NORMALIZED_ARGS[@]:2}") ;;
        create) NORMALIZED_ARGS=(svc-new "${NORMALIZED_ARGS[@]:2}") ;;
        create-custom) NORMALIZED_ARGS=(svc-new-custom "${NORMALIZED_ARGS[@]:2}") ;;
        start) NORMALIZED_ARGS=(svc-start "${NORMALIZED_ARGS[@]:2}") ;;
        stop) NORMALIZED_ARGS=(svc-stop "${NORMALIZED_ARGS[@]:2}") ;;
        rm) NORMALIZED_ARGS=(svc-rm "${NORMALIZED_ARGS[@]:2}") ;;
        inspect) NORMALIZED_ARGS=(svc-info "${NORMALIZED_ARGS[@]:2}") ;;
        help|-h|--help|"") NORMALIZED_ARGS=(help) ;;
        *) die "Unknown service subcommand: ${sub}. Use: ${CLI_NAME} help" ;;
      esac
      ;;
    port)
      sub="${NORMALIZED_ARGS[1]:-}"
      case "$sub" in
        ls) NORMALIZED_ARGS=(port-list "${NORMALIZED_ARGS[@]:2}") ;;
        open) NORMALIZED_ARGS=(port-open "${NORMALIZED_ARGS[@]:2}") ;;
        close) NORMALIZED_ARGS=(port-close "${NORMALIZED_ARGS[@]:2}") ;;
        help|-h|--help|"") NORMALIZED_ARGS=(help) ;;
        *) die "Unknown port subcommand: ${sub}. Use: ${CLI_NAME} port ls|open|close" ;;
      esac
      ;;
  esac
}

normalize_cli_args "$@"
set -- "${NORMALIZED_ARGS[@]}"
cmd="${1:-help}"
name="${2:-}"

ensure_ssh_key() {
  mkdir -p ~/.ssh
  chmod 700 ~/.ssh
  if [[ ! -f "$KEY_PRIV" || ! -f "$KEY_PUB" ]]; then
    echo "Generating SSH key at $KEY_PRIV"
    ssh-keygen -t ed25519 -f "$KEY_PRIV" -N "" >/dev/null
  fi
}

expand_home_path() {
  local p="$1"
  if [[ "$p" == "~" ]]; then
    printf '%s' "$HOME"
  elif [[ "$p" == "~/"* ]]; then
    printf '%s/%s' "$HOME" "${p#~/}"
  else
    printf '%s' "$p"
  fi
}

resolve_github_key_path() {
  local cand
  if [[ "${ENVD_COPY_GITHUB_KEY:-1}" == "0" ]]; then
    return 1
  fi

  if [[ -n "${ENVD_GITHUB_KEY:-}" ]]; then
    cand="$(expand_home_path "${ENVD_GITHUB_KEY}")"
    [[ -f "$cand" ]] || die "ENVD_GITHUB_KEY file not found: ${ENVD_GITHUB_KEY}"
    printf '%s' "$cand"
    return 0
  fi

  while IFS= read -r cand; do
    cand="$(expand_home_path "$cand")"
    if [[ -f "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done < <(ssh -G github.com 2>/dev/null | awk '/^identityfile / {print $2}')

  for cand in "${HOME}/.ssh/github_key" "${HOME}/.ssh/id_ed25519"; do
    if [[ -f "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done

  return 1
}

install_github_key_in_env() {
  local container="$1" user="$2" host_key="$3" host_key_pub
  host_key_pub="${host_key}.pub"

  docker cp "$host_key" "${container}:/home/${user}/.ssh/github_key"
  if [[ -f "$host_key_pub" ]]; then
    docker cp "$host_key_pub" "${container}:/home/${user}/.ssh/github_key.pub"
  fi

  docker exec -u root "$container" bash -lc "cfg=/home/${user}/.ssh/config
touch \"\$cfg\"
chmod 600 \"\$cfg\"
awk '
BEGIN{skip=0}
/^# >>> envd github >>>$/ {skip=1; next}
/^# <<< envd github <<<$/{skip=0; next}
skip==0 {print}
' \"\$cfg\" > \"\${cfg}.tmp\"
mv \"\${cfg}.tmp\" \"\$cfg\"
cat >>\"\$cfg\" <<'EOF'
# >>> envd github >>>
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/github_key
  IdentitiesOnly yes
# <<< envd github <<<
EOF
chown ${user}:${user} /home/${user}/.ssh/config /home/${user}/.ssh/github_key 2>/dev/null || true
chmod 600 /home/${user}/.ssh/config /home/${user}/.ssh/github_key
if [[ -f /home/${user}/.ssh/github_key.pub ]]; then
  chown ${user}:${user} /home/${user}/.ssh/github_key.pub
  chmod 644 /home/${user}/.ssh/github_key.pub
fi"
}

ensure_env_ssh_dir() {
  local container="$1" user="$2"
  docker exec -u root "$container" bash -lc "mkdir -p /home/${user}/.ssh && chmod 700 /home/${user}/.ssh && chown -R ${user}:${user} /home/${user}/.ssh" >/dev/null
}

resolve_automations_dir() {
  local d repo_dir
  if [[ -n "${ENVD_AUTOMATIONS_DIR:-}" ]]; then
    [[ -d "$ENVD_AUTOMATIONS_DIR" ]] || die "ENVD_AUTOMATIONS_DIR does not exist: $ENVD_AUTOMATIONS_DIR"
    printf '%s' "$ENVD_AUTOMATIONS_DIR"
    return 0
  fi

  local pwd_candidate script_candidate envd_home_candidate
  pwd_candidate="${PWD}/dev-containers/automations"
  script_candidate="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../dev-containers/automations"
  envd_home_candidate="${HOME}/repo/envd/dev-containers/automations"

  # Prefer non-empty automation directories to avoid stale empty paths.
  for d in "$pwd_candidate" "$script_candidate" "$envd_home_candidate"; do
    if [[ -d "$d" ]] && find "$d" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
      printf '%s' "$d"
      return 0
    fi
  done

  if [[ -d "${HOME}/repo" ]]; then
    for repo_dir in "${HOME}/repo"/*; do
      [[ -d "$repo_dir" ]] || continue
      d="${repo_dir}/dev-containers/automations"
      if [[ -d "$d" ]] && find "$d" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
        printf '%s' "$d"
        return 0
      fi
    done
  fi

  # Fall back to existing dirs even if empty.
  for d in "$pwd_candidate" "$script_candidate" "$envd_home_candidate"; do
    if [[ -d "$d" ]]; then
      printf '%s' "$d"
      return 0
    fi
  done

  if [[ -d "${HOME}/repo" ]]; then
    for repo_dir in "${HOME}/repo"/*; do
      [[ -d "$repo_dir" ]] || continue
      d="${repo_dir}/dev-containers/automations"
      if [[ -d "$d" ]]; then
        printf '%s' "$d"
        return 0
      fi
    done
  fi

  return 1
}

resolve_docker_socket() {
  local sock
  if [[ -n "${ENVD_DOCKER_SOCK:-}" ]]; then
    [[ -S "$ENVD_DOCKER_SOCK" ]] || die "ENVD_DOCKER_SOCK is not a unix socket: $ENVD_DOCKER_SOCK"
    printf '%s' "$ENVD_DOCKER_SOCK"
    return 0
  fi

  for sock in /var/run/docker.sock "${HOME}/.docker/run/docker.sock"; do
    if [[ -S "$sock" ]]; then
      printf '%s' "$sock"
      return 0
    fi
  done

  return 1
}

ensure_network_and_image() {
  docker network inspect "$NETWORK" >/dev/null 2>&1 || die "Network '$NETWORK' not found. Start vpn-gateway first."
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "Image '$IMAGE' not found. Build it first: docker build -t $IMAGE <path>"
  docker image inspect "$NET_IMAGE" >/dev/null 2>&1 || die "Image '$NET_IMAGE' not found. Build it first: docker build -t $NET_IMAGE <path-to-dev-containers/net-sidecar>"
}

pick_port() {
  local p=$PORT_BASE
  while [[ $p -le $PORT_MAX ]]; do
    if ! nc -z 127.0.0.1 "$p" >/dev/null 2>&1; then
      echo "$p"; return 0
    fi
    p=$((p+1))
  done
  return 1
}

ensure_port_number() {
  local p="$1" field="$2"
  [[ "$p" =~ ^[0-9]+$ ]] || die "Invalid ${field}: '${p}' (must be numeric)"
  (( p >= 1 && p <= 65535 )) || die "Invalid ${field}: '${p}' (must be 1-65535)"
}

port_fwd_name() {
  local env_name="$1" host_port="$2" container_port="$3"
  echo "${env_name}-pf-${host_port}-${container_port}"
}

ensure_port_forward_image() {
  docker image inspect "$PORT_FWD_IMAGE" >/dev/null 2>&1 || docker pull "$PORT_FWD_IMAGE" >/dev/null
}

allow_sidecar_port() {
  local env_name="$1" target_port="$2"
  docker exec "${env_name}-net" sh -lc \
    "iptables -C INPUT -p tcp --dport ${target_port} -j ACCEPT >/dev/null 2>&1 || iptables -I INPUT 1 -p tcp --dport ${target_port} -j ACCEPT"
}

deny_sidecar_port() {
  local env_name="$1" target_port="$2"
  docker exec "${env_name}-net" sh -lc \
    "iptables -D INPUT -p tcp --dport ${target_port} -j ACCEPT >/dev/null 2>&1 || true"
}

port_forward_ids_for_env() {
  local env_name="$1"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_PORT" \
    --filter "label=envd.name=$env_name" \
    --format '{{.ID}}'
}

service_canonical() {
  local service="$1"
  case "$service" in
    postgres) echo "postgres" ;;
    redis) echo "redis" ;;
    mongodb|mongo) echo "mongo" ;;
    elasticsearch|es) echo "elasticsearch" ;;
    *)
      die "Unsupported service '${service}'. Supported: postgres, redis, mongo|mongodb, elasticsearch|es"
      ;;
  esac
}

validate_service_instance() {
  local instance="$1"
  [[ "$instance" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "Invalid service instance '${instance}'. Use lowercase letters, digits, hyphen (max 32 chars)."
}

service_instance_value() {
  local instance="${1:-default}"
  validate_service_instance "$instance"
  echo "$instance"
}

service_container_name() {
  local env_name="$1" service="$2" instance="${3:-default}"
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  if [[ "$instance" == "default" ]]; then
    echo "${env_name}-svc-${service}"
  else
    echo "${env_name}-svc-${service}-${instance}"
  fi
}

service_volume_name() {
  local env_name="$1" service="$2" instance="${3:-default}"
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  if [[ "$instance" == "default" ]]; then
    echo "${env_name}-svc-${service}-data"
  else
    echo "${env_name}-svc-${service}-${instance}-data"
  fi
}

service_default_port() {
  local service="$1"
  service="$(service_canonical "$service")"
  case "$service" in
    postgres) echo "5432" ;;
    redis) echo "6379" ;;
    mongo) echo "27017" ;;
    elasticsearch) echo "9200" ;;
  esac
}

service_aliases() {
  local service="$1"
  service="$(service_canonical "$service")"
  case "$service" in
    postgres) echo "postgres" ;;
    redis) echo "redis" ;;
    mongo) echo "mongo, mongodb" ;;
    elasticsearch) echo "elasticsearch, es" ;;
  esac
}

service_catalog() {
  printf "%-14s %-20s %-10s %s\n" "SERVICE" "ALIASES" "BASE_PORT" "DEFAULTS"
  printf "%-14s %-20s %-10s %s\n" "postgres" "postgres" "5432" "user=dev db=app pass=dev"
  printf "%-14s %-20s %-10s %s\n" "redis" "redis" "6379" "optional password"
  printf "%-14s %-20s %-10s %s\n" "mongo" "mongo, mongodb" "27017" "optional root auth"
  printf "%-14s %-20s %-10s %s\n" "elasticsearch" "elasticsearch, es" "9200" "xpack.security=false"
  cat <<EOT

Instances:
  You can run multiple instances per service:
    ${CLI_NAME} service create <name> <service> [instance]
  If port is not specified, the next free port is auto-selected from BASE_PORT upward.

Override defaults with env vars before ${CLI_NAME} service create:
  ENVD_SVC_PORT
  ENVD_POSTGRES_VERSION ENVD_POSTGRES_USER ENVD_POSTGRES_PASSWORD ENVD_POSTGRES_DB
  ENVD_REDIS_VERSION ENVD_REDIS_PASSWORD
  ENVD_MONGO_VERSION ENVD_MONGO_INITDB_ROOT_USERNAME ENVD_MONGO_INITDB_ROOT_PASSWORD
  ENVD_ELASTIC_VERSION ENVD_ELASTIC_JAVA_OPTS

Interactive setup:
  ${CLI_NAME} service create-custom <name> <service> [instance]   (legacy alias: svc-start-custom)
EOT
}

prompt_default() {
  local label="$1" default="${2:-}" value
  if [[ -n "$default" ]]; then
    read -r -p "${label} [${default}]: " value
    printf '%s' "${value:-$default}"
  else
    read -r -p "${label}: " value
    printf '%s' "$value"
  fi
}

prompt_secret_default() {
  local label="$1" default="${2:-}" value
  if [[ -n "$default" ]]; then
    read -r -s -p "${label} [hidden, Enter keeps current]: " value
    echo >&2
    printf '%s' "${value:-$default}"
  else
    read -r -s -p "${label} [hidden]: " value
    echo >&2
    printf '%s' "$value"
  fi
}

docker_env_value() {
  local container="$1" key="$2"
  docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null \
    | awk -v k="$key" '
      index($0, k "=") == 1 { print substr($0, length(k) + 2); found=1; exit }
      END { if (!found) exit 1 }
    '
}

service_ids_for_env() {
  local env_name="$1"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_SVC" \
    --filter "label=envd.name=$env_name" \
    --format '{{.ID}}'
}

service_port_for_container() {
  local svc_name="$1" service="$2"
  local svc_port
  svc_port="$(docker inspect -f '{{ index .Config.Labels "envd.port" }}' "$svc_name" 2>/dev/null || true)"
  if [[ -z "$svc_port" ]]; then
    svc_port="$(service_default_port "$service")"
  fi
  printf '%s' "$svc_port"
}

service_port_in_use() {
  local env_name="$1" target_port="$2"
  local svc_ids id current_port current_service
  svc_ids="$(service_ids_for_env "$env_name")"
  [[ -n "$svc_ids" ]] || return 1

  for id in $svc_ids; do
    current_port="$(docker inspect -f '{{ index .Config.Labels "envd.port" }}' "$id" 2>/dev/null || true)"
    current_service="$(docker inspect -f '{{ index .Config.Labels "envd.service" }}' "$id" 2>/dev/null || true)"
    if [[ -z "$current_port" && -n "$current_service" ]]; then
      current_port="$(service_default_port "$current_service")"
    fi
    [[ "$current_port" == "$target_port" ]] && return 0
  done

  return 1
}

service_pick_port() {
  local env_name="$1" service="$2" requested_port="${3:-}"
  local candidate

  if [[ -n "$requested_port" ]]; then
    ensure_port_number "$requested_port" "service-port"
    service_port_in_use "$env_name" "$requested_port" && die "Service port ${requested_port} is already in use in ${env_name}."
    printf '%s' "$requested_port"
    return 0
  fi

  candidate="$(service_default_port "$service")"
  while service_port_in_use "$env_name" "$candidate"; do
    candidate=$((candidate + 1))
    (( candidate <= 65535 )) || die "No free service ports left for ${service} in ${env_name}."
  done
  printf '%s' "$candidate"
}

service_collect_custom_env() {
  local env_name="$1" service="$2" instance="$3"
  local suggested_port svc_port
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  SVC_CUSTOM_EXPORTS=()

  suggested_port="$(service_pick_port "$env_name" "$service" "${ENVD_SVC_PORT:-}")"
  svc_port="$(prompt_default "Internal port for ${service}/${instance}" "$suggested_port")"
  SVC_CUSTOM_EXPORTS+=("ENVD_SVC_PORT=${svc_port}")

  case "$service" in
    postgres)
      local pg_ver pg_user pg_pass pg_db
      pg_ver="$(prompt_default "Postgres version" "${ENVD_POSTGRES_VERSION:-16}")"
      pg_user="$(prompt_default "Postgres user" "${ENVD_POSTGRES_USER:-dev}")"
      pg_pass="$(prompt_secret_default "Postgres password" "${ENVD_POSTGRES_PASSWORD:-dev}")"
      pg_db="$(prompt_default "Postgres database" "${ENVD_POSTGRES_DB:-app}")"
      SVC_CUSTOM_EXPORTS+=("ENVD_POSTGRES_VERSION=${pg_ver}")
      SVC_CUSTOM_EXPORTS+=("ENVD_POSTGRES_USER=${pg_user}")
      SVC_CUSTOM_EXPORTS+=("ENVD_POSTGRES_PASSWORD=${pg_pass}")
      SVC_CUSTOM_EXPORTS+=("ENVD_POSTGRES_DB=${pg_db}")
      ;;
    redis)
      local redis_ver redis_pass
      redis_ver="$(prompt_default "Redis version" "${ENVD_REDIS_VERSION:-7-alpine}")"
      redis_pass="$(prompt_secret_default "Redis password (empty = no auth)" "${ENVD_REDIS_PASSWORD:-}")"
      SVC_CUSTOM_EXPORTS+=("ENVD_REDIS_VERSION=${redis_ver}")
      SVC_CUSTOM_EXPORTS+=("ENVD_REDIS_PASSWORD=${redis_pass}")
      ;;
    mongo)
      local mongo_ver mongo_user mongo_pass
      mongo_ver="$(prompt_default "Mongo version" "${ENVD_MONGO_VERSION:-7}")"
      mongo_user="$(prompt_default "Mongo root username (empty = no auth)" "${ENVD_MONGO_INITDB_ROOT_USERNAME:-}")"
      mongo_pass=""
      if [[ -n "$mongo_user" ]]; then
        mongo_pass="$(prompt_secret_default "Mongo root password" "${ENVD_MONGO_INITDB_ROOT_PASSWORD:-}")"
        [[ -n "$mongo_pass" ]] || die "Mongo root password cannot be empty when username is set."
      fi
      SVC_CUSTOM_EXPORTS+=("ENVD_MONGO_VERSION=${mongo_ver}")
      SVC_CUSTOM_EXPORTS+=("ENVD_MONGO_INITDB_ROOT_USERNAME=${mongo_user}")
      SVC_CUSTOM_EXPORTS+=("ENVD_MONGO_INITDB_ROOT_PASSWORD=${mongo_pass}")
      ;;
    elasticsearch)
      local es_ver es_java_opts
      es_ver="$(prompt_default "Elasticsearch version" "${ENVD_ELASTIC_VERSION:-8.13.4}")"
      es_java_opts="$(prompt_default "Elasticsearch ES_JAVA_OPTS" "${ENVD_ELASTIC_JAVA_OPTS:--Xms512m -Xmx512m}")"
      SVC_CUSTOM_EXPORTS+=("ENVD_ELASTIC_VERSION=${es_ver}")
      SVC_CUSTOM_EXPORTS+=("ENVD_ELASTIC_JAVA_OPTS=${es_java_opts}")
      ;;
  esac
}

port_forward_host_ports_for_target() {
  local env_name="$1" target_port="$2"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_PORT" \
    --filter "label=envd.name=$env_name" \
    --filter "label=envd.target_port=$target_port" \
    --format '{{.Label "envd.host_port"}}'
}

service_info() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local canonical svc_name port status host_ports host_line

  canonical="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$canonical" "$instance")"

  if docker inspect "$svc_name" >/dev/null 2>&1; then
    status="$(docker inspect -f '{{.State.Status}}' "$svc_name" 2>/dev/null || echo "unknown")"
    port="$(service_port_for_container "$svc_name" "$canonical")"
  else
    status="not-created"
    port="$(service_default_port "$canonical")"
  fi

  host_ports="$(port_forward_host_ports_for_target "$env_name" "$port")"
  if [[ -n "$host_ports" ]]; then
    host_line="$(echo "$host_ports" | awk 'NF{printf "%s127.0.0.1:%s", (sep? ", ":""), $0; sep=1} END{if(!sep) printf "not exposed"}')"
  else
    host_line="not exposed (use: ${CLI_NAME} port open ${env_name} ${port})"
  fi

  echo "Service: ${canonical} (requested: ${service})"
  echo "Instance: ${instance}"
  echo "Container: ${svc_name}"
  echo "Aliases: $(service_aliases "$canonical")"
  echo "Status: ${status}"
  echo "In-container endpoint: 127.0.0.1:${port}"
  echo "Host endpoint(s): ${host_line}"

  case "$canonical" in
    postgres)
      local pg_user pg_pass pg_db v
      pg_user="${ENVD_POSTGRES_USER:-dev}"
      pg_pass="${ENVD_POSTGRES_PASSWORD:-dev}"
      pg_db="${ENVD_POSTGRES_DB:-app}"

      if docker inspect "$svc_name" >/dev/null 2>&1; then
        v="$(docker_env_value "$svc_name" "POSTGRES_USER" 2>/dev/null || true)"; [[ -n "$v" ]] && pg_user="$v"
        v="$(docker_env_value "$svc_name" "POSTGRES_PASSWORD" 2>/dev/null || true)"; [[ -n "$v" ]] && pg_pass="$v"
        v="$(docker_env_value "$svc_name" "POSTGRES_DB" 2>/dev/null || true)"; [[ -n "$v" ]] && pg_db="$v"
      fi

      echo "Credentials: user=${pg_user} password=${pg_pass} db=${pg_db}"
      echo "URI (inside ${env_name}): postgres://${pg_user}:${pg_pass}@127.0.0.1:${port}/${pg_db}"
      ;;
    redis)
      local redis_pass v
      redis_pass="${ENVD_REDIS_PASSWORD:-}"
      if docker inspect "$svc_name" >/dev/null 2>&1; then
        v="$(docker_env_value "$svc_name" "REDIS_PASSWORD" 2>/dev/null || true)"; [[ -n "$v" ]] && redis_pass="$v"
      fi
      if [[ -n "$redis_pass" ]]; then
        echo "Credentials: password=${redis_pass}"
        echo "URI (inside ${env_name}): redis://:${redis_pass}@127.0.0.1:${port}"
      else
        echo "Credentials: none"
        echo "URI (inside ${env_name}): redis://127.0.0.1:${port}"
      fi
      ;;
    mongo)
      local mongo_user mongo_pass v
      mongo_user="${ENVD_MONGO_INITDB_ROOT_USERNAME:-}"
      mongo_pass="${ENVD_MONGO_INITDB_ROOT_PASSWORD:-}"
      if docker inspect "$svc_name" >/dev/null 2>&1; then
        v="$(docker_env_value "$svc_name" "MONGO_INITDB_ROOT_USERNAME" 2>/dev/null || true)"; [[ -n "$v" ]] && mongo_user="$v"
        v="$(docker_env_value "$svc_name" "MONGO_INITDB_ROOT_PASSWORD" 2>/dev/null || true)"; [[ -n "$v" ]] && mongo_pass="$v"
      fi
      if [[ -n "$mongo_user" ]]; then
        echo "Credentials: user=${mongo_user} password=${mongo_pass}"
        echo "URI (inside ${env_name}): mongodb://${mongo_user}:${mongo_pass}@127.0.0.1:${port}/admin"
      else
        echo "Credentials: none"
        echo "URI (inside ${env_name}): mongodb://127.0.0.1:${port}"
      fi
      ;;
    elasticsearch)
      echo "Credentials: none (xpack security disabled)"
      echo "URL (inside ${env_name}): http://127.0.0.1:${port}"
      ;;
  esac
}

service_exists() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local svc_name
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"
  docker inspect "$svc_name" >/dev/null 2>&1
}

service_resolve_ref() {
  local env_name="$1" ref="$2"
  local role resolved_env resolved_service resolved_instance

  if docker inspect "$ref" >/dev/null 2>&1; then
    role="$(docker inspect -f '{{ index .Config.Labels "envd.role" }}' "$ref" 2>/dev/null || true)"
    resolved_env="$(docker inspect -f '{{ index .Config.Labels "envd.name" }}' "$ref" 2>/dev/null || true)"
    resolved_service="$(docker inspect -f '{{ index .Config.Labels "envd.service" }}' "$ref" 2>/dev/null || true)"
    resolved_instance="$(docker inspect -f '{{ index .Config.Labels "envd.instance" }}' "$ref" 2>/dev/null || true)"

    [[ "$role" == "$ROLE_SVC" ]] || die "Container '${ref}' is not a managed service."
    [[ "$resolved_env" == "$env_name" ]] || die "Service container '${ref}' belongs to env '${resolved_env}', not '${env_name}'."
    [[ -n "$resolved_service" ]] || die "Service container '${ref}' is missing service metadata."
    [[ -n "$resolved_instance" ]] || resolved_instance="default"

    SVC_RESOLVED_SERVICE="$resolved_service"
    SVC_RESOLVED_INSTANCE="$resolved_instance"
    return 0
  fi

  SVC_RESOLVED_SERVICE="$(service_canonical "$ref")"
  SVC_RESOLVED_INSTANCE="default"
}

service_spec() {
  local env_name="$1" service="$2" instance="$3" svc_port="$4"
  local transport_port
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  ensure_port_number "$svc_port" "service-port"
  SVC_IMAGE=""
  SVC_VOL_NAME="$(service_volume_name "$env_name" "$service" "$instance")"
  SVC_VOL_MOUNT=""
  SVC_ENV_ARGS=()
  SVC_CMD_ARGS=()
  SVC_RUN_ARGS=()

  case "$service" in
    postgres)
      local pg_ver pg_user pg_pass pg_db
      pg_ver="${ENVD_POSTGRES_VERSION:-16}"
      pg_user="${ENVD_POSTGRES_USER:-dev}"
      pg_pass="${ENVD_POSTGRES_PASSWORD:-dev}"
      pg_db="${ENVD_POSTGRES_DB:-app}"
      SVC_IMAGE="postgres:${pg_ver}"
      SVC_VOL_MOUNT="/var/lib/postgresql/data"
      SVC_ENV_ARGS=(-e "POSTGRES_USER=${pg_user}" -e "POSTGRES_PASSWORD=${pg_pass}" -e "POSTGRES_DB=${pg_db}")
      SVC_CMD_ARGS=("postgres" "-p" "$svc_port")
      ;;
    redis)
      local redis_ver redis_pass
      redis_ver="${ENVD_REDIS_VERSION:-7-alpine}"
      redis_pass="${ENVD_REDIS_PASSWORD:-}"
      SVC_IMAGE="redis:${redis_ver}"
      SVC_VOL_MOUNT="/data"
      if [[ -n "$redis_pass" ]]; then
        SVC_ENV_ARGS=(-e "REDIS_PASSWORD=${redis_pass}" -e "REDIS_PORT=${svc_port}")
        SVC_CMD_ARGS=("sh" "-lc" 'exec redis-server --appendonly yes --port "$REDIS_PORT" --requirepass "$REDIS_PASSWORD"')
      else
        SVC_CMD_ARGS=("redis-server" "--appendonly" "yes" "--port" "$svc_port")
      fi
      ;;
    mongo)
      local mongo_ver mongo_user mongo_pass
      mongo_ver="${ENVD_MONGO_VERSION:-7}"
      mongo_user="${ENVD_MONGO_INITDB_ROOT_USERNAME:-}"
      mongo_pass="${ENVD_MONGO_INITDB_ROOT_PASSWORD:-}"
      if [[ -n "$mongo_user" && -z "$mongo_pass" ]]; then
        die "Mongo root password is required when ENVD_MONGO_INITDB_ROOT_USERNAME is set."
      fi
      if [[ -z "$mongo_user" && -n "$mongo_pass" ]]; then
        die "Mongo root username is required when ENVD_MONGO_INITDB_ROOT_PASSWORD is set."
      fi
      SVC_IMAGE="mongo:${mongo_ver}"
      SVC_VOL_MOUNT="/data/db"
      if [[ -n "$mongo_user" ]]; then
        SVC_ENV_ARGS=(-e "MONGO_INITDB_ROOT_USERNAME=${mongo_user}" -e "MONGO_INITDB_ROOT_PASSWORD=${mongo_pass}")
      fi
      SVC_CMD_ARGS=("mongod" "--bind_ip_all" "--port" "$svc_port")
      ;;
    elasticsearch)
      local es_ver es_java_opts
      es_ver="${ENVD_ELASTIC_VERSION:-8.13.4}"
      es_java_opts="${ENVD_ELASTIC_JAVA_OPTS:--Xms512m -Xmx512m}"
      transport_port=$((svc_port + 100))
      if (( transport_port > 65535 )); then
        transport_port=$((svc_port + 1))
      fi
      (( transport_port <= 65535 )) || die "Could not allocate elasticsearch transport port for service-port ${svc_port}."

      SVC_IMAGE="docker.elastic.co/elasticsearch/elasticsearch:${es_ver}"
      SVC_VOL_MOUNT="/usr/share/elasticsearch/data"
      SVC_ENV_ARGS=(-e "discovery.type=single-node" -e "xpack.security.enabled=false" -e "ES_JAVA_OPTS=${es_java_opts}" -e "http.port=${svc_port}" -e "transport.port=${transport_port}")
      SVC_RUN_ARGS=(--ulimit "memlock=-1:-1")
      ;;
  esac
}

service_ensure_volume() {
  local env_name="$1" service="$2" instance="$3"
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  SVC_VOL_NAME="$(service_volume_name "$env_name" "$service" "$instance")"
  docker volume inspect "$SVC_VOL_NAME" >/dev/null 2>&1 || \
    docker volume create \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_SVC" \
      --label "envd.name=$env_name" \
      --label "envd.service=$service" \
      --label "envd.instance=$instance" \
      "$SVC_VOL_NAME" >/dev/null
}

service_start_one() {
  local env_name="$1" service="$2" instance="${3:-default}" requested_port="${4:-}"
  local svc_name svc_port
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"

  docker inspect "${env_name}-net" >/dev/null 2>&1 || die "No such sidecar: ${env_name}-net"
  docker start "${env_name}-net" >/dev/null 2>&1 || true
  wait_for_healthy "${env_name}-net" || die "Sidecar '${env_name}-net' did not become healthy."

  if docker inspect "$svc_name" >/dev/null 2>&1; then
    docker start "$svc_name" >/dev/null 2>&1 || true
    SVC_LAST_ACTION="started"
    SVC_LAST_PORT="$(service_port_for_container "$svc_name" "$service")"
    return 0
  fi

  svc_port="$(service_pick_port "$env_name" "$service" "$requested_port")"
  service_spec "$env_name" "$service" "$instance" "$svc_port"
  service_ensure_volume "$env_name" "$service" "$instance"

  local vol_args=()
  if [[ -n "$SVC_VOL_NAME" && -n "$SVC_VOL_MOUNT" ]]; then
    vol_args=(-v "${SVC_VOL_NAME}:${SVC_VOL_MOUNT}")
  fi

  local docker_args=(
    -d
    --name "$svc_name"
    --label "$LABEL_KEY=$LABEL_VAL"
    --label "$ROLE_KEY=$ROLE_SVC"
    --label "envd.name=$env_name"
    --label "envd.service=$service"
    --label "envd.instance=$instance"
    --label "envd.port=$svc_port"
    --restart unless-stopped
    --network "container:${env_name}-net"
  )
  if [[ ${#SVC_RUN_ARGS[@]} -gt 0 ]]; then
    docker_args+=("${SVC_RUN_ARGS[@]}")
  fi
  if [[ ${#SVC_ENV_ARGS[@]} -gt 0 ]]; then
    docker_args+=("${SVC_ENV_ARGS[@]}")
  fi
  if [[ ${#vol_args[@]} -gt 0 ]]; then
    docker_args+=("${vol_args[@]}")
  fi
  docker_args+=("$SVC_IMAGE")
  if [[ ${#SVC_CMD_ARGS[@]} -gt 0 ]]; then
    docker_args+=("${SVC_CMD_ARGS[@]}")
  fi

  docker run "${docker_args[@]}" >/dev/null
  SVC_LAST_ACTION="created"
  SVC_LAST_PORT="$svc_port"
}

service_stop_one() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local svc_name
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"
  docker inspect "$svc_name" >/dev/null 2>&1 || die "No such service container: $svc_name"
  docker stop "$svc_name" >/dev/null 2>&1 || true
}

service_rm_one() {
  local env_name="$1" service="$2" instance="${3:-default}"
  local svc_name svc_vol_name
  service="$(service_canonical "$service")"
  instance="$(service_instance_value "$instance")"
  svc_name="$(service_container_name "$env_name" "$service" "$instance")"
  svc_vol_name="$(service_volume_name "$env_name" "$service" "$instance")"

  docker inspect "$svc_name" >/dev/null 2>&1 || die "No such service container: $svc_name"
  docker rm -f "$svc_name" >/dev/null
  docker volume rm "$svc_vol_name" >/dev/null 2>&1 || true
}

service_start_all_for_env() {
  local env_name="$1"
  local svc_ids
  svc_ids="$(service_ids_for_env "$env_name")"
  if [[ -n "$svc_ids" ]]; then
    docker start $svc_ids >/dev/null 2>&1 || true
  fi
}

service_stop_all_for_env() {
  local env_name="$1"
  local svc_ids
  svc_ids="$(service_ids_for_env "$env_name")"
  if [[ -n "$svc_ids" ]]; then
    docker stop $svc_ids >/dev/null 2>&1 || true
  fi
}

service_rm_all_for_env() {
  local env_name="$1"
  local svc_ids svc_vol_ids

  svc_ids="$(service_ids_for_env "$env_name")"
  if [[ -n "$svc_ids" ]]; then
    docker rm -f $svc_ids >/dev/null 2>&1 || true
  fi

  svc_vol_ids="$(docker volume ls -q \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_SVC" \
    --filter "label=envd.name=$env_name")"
  if [[ -n "$svc_vol_ids" ]]; then
    docker volume rm $svc_vol_ids >/dev/null 2>&1 || true
  fi
}

port_target_ports_for_env() {
  local env_name="$1"
  docker ps -a \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_PORT" \
    --filter "label=envd.name=$env_name" \
    --format '{{.Label "envd.target_port"}}'
}

allow_sidecar_ports_for_env() {
  local env_name="$1"
  local mapped_ports
  mapped_ports="$(port_target_ports_for_env "$env_name")"
  if [[ -n "$mapped_ports" ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      allow_sidecar_port "$env_name" "$p"
    done <<< "$mapped_ports"
  fi
}

wait_for_healthy() {
  local container="$1"
  for _ in {1..80}; do
    local status
    status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container" 2>/dev/null || true)"
    if [[ "$status" == "healthy" ]]; then
      return 0
    fi
    if [[ "$status" == "unhealthy" ]]; then
      return 1
    fi
    sleep 0.25
  done
  return 1
}

remove_ssh_config_host() {
  local host="$1"
  [[ -f "$SSHCFG" ]] || return 0
  awk -v h="$host" '
    BEGIN{skip=0}
    $1=="Host" && $2==h {skip=1; next}
    $1=="Host" && skip==1 {skip=0}
    skip==0 {print}
  ' "$SSHCFG" > "${SSHCFG}.tmp"
  mv "${SSHCFG}.tmp" "$SSHCFG"
}

remove_known_host_entry() {
  local host="$1" port="$2"
  mkdir -p "${HOME}/.ssh"
  touch "$KNOWN_HOSTS_FILE"
  chmod 600 "$KNOWN_HOSTS_FILE"
  ssh-keygen -R "[${host}]:${port}" -f "$KNOWN_HOSTS_FILE" >/dev/null 2>&1 || true
}

set_ssh_config_host() {
  local host="$1" port="$2" user="$3"

  touch "$SSHCFG"
  chmod 600 "$SSHCFG"

  # remove old block if exists
  remove_ssh_config_host "$host"
  # avoid stale key mismatch when a recreated env reuses the same local port
  remove_known_host_entry "127.0.0.1" "$port"

  cat >> "$SSHCFG" <<EOCFG

Host ${host}
  HostName 127.0.0.1
  Port ${port}
  User ${user}
  IdentityFile ${KEY_PRIV}
  IdentitiesOnly yes
  ForwardAgent yes
  UserKnownHostsFile ${KNOWN_HOSTS_FILE}
  StrictHostKeyChecking accept-new

EOCFG
}

validate_name_and_user() {
  local n="$1"
  [[ "$n" =~ ^[a-z][a-z0-9]{0,31}$ ]] || die "Invalid name '$n'. Must match: ^[a-z][a-z0-9]{0,31}$ (example: dev1, alice2)."
}

DOCTOR_OK_COUNT=0
DOCTOR_WARN_COUNT=0
DOCTOR_FAIL_COUNT=0

doctor_line() {
  local level="$1"
  shift
  printf "%-6s %s\n" "$level" "$*"
}

doctor_ok() {
  DOCTOR_OK_COUNT=$((DOCTOR_OK_COUNT + 1))
  doctor_line "OK" "$*"
}

doctor_warn() {
  DOCTOR_WARN_COUNT=$((DOCTOR_WARN_COUNT + 1))
  doctor_line "WARN" "$*"
}

doctor_fail() {
  DOCTOR_FAIL_COUNT=$((DOCTOR_FAIL_COUNT + 1))
  doctor_line "FAIL" "$*"
}

env_volume_names_for_backup() {
  local env_name="$1"
  printf '%s\n' "${env_name}-home"
  printf '%s\n' "${env_name}-repo"
  docker volume ls -q \
    --filter "label=$LABEL_KEY=$LABEL_VAL" \
    --filter "label=$ROLE_KEY=$ROLE_SVC" \
    --filter "label=envd.name=$env_name"
}

archive_top_dirs() {
  local archive="$1"
  tar -tzf "$archive" 2>/dev/null \
    | awk '{
        path=$0
        sub(/^\.\//, "", path)
        n=split(path, parts, "/")
        if (n > 0 && parts[1] != "." && parts[1] != "") print parts[1]
      }' \
    | awk 'NF && !seen[$0]++ {print $0}'
}

case "$cmd" in
  help|-h|--help|"")
    usage
    ;;

  list)
    printf "%-20s %-8s %-28s %s\n" "NAME" "STATE" "STATUS" "IMAGE"
    docker ps -a --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --format "{{.Names}}\t{{.Status}}\t{{.Image}}\t{{.Label \"$ROLE_KEY\"}}" \
      | awk -F '\t' 'BEGIN{OFS="\t"} {
          if ($4 == "net" || $4 == "port" || $4 == "svc" || $1 ~ /-net$/) next;
          state = "stopped";
          if ($2 ~ /^Up( |$)/ || $2 ~ /^Restarting( |$)/) state = "active";
          printf "%-20s %-8s %-28s %s\n", $1, state, $2, $3
        }'
    ;;

  new)
    [[ -z "$name" ]] && die "Usage: ${CLI_NAME} run <name>"
    validate_name_and_user "$name"
    ensure_network_and_image
    ensure_ssh_key

    docker inspect "$name" >/dev/null 2>&1 && die "Container '$name' already exists."

    USER_NAME="$name"
    NET_NAME="${name}-net"
    HOST_GIT_NAME="$(git config --global --get user.name 2>/dev/null || true)"
    HOST_GIT_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"
    PORT="$(pick_port)" || die "No free port in ${PORT_BASE}-${PORT_MAX}"

    HOME_VOL="${name}-home"
    REPO_VOL="${name}-repo"
    created_home_vol="false"
    created_repo_vol="false"
    created_net="false"
    created_dev="false"

    cleanup_partial_new() {
      local code=$?
      if [[ $code -eq 0 ]]; then
        return 0
      fi

      [[ "$created_dev" == "true" ]] && docker rm -f "$name" >/dev/null 2>&1 || true
      [[ "$created_net" == "true" ]] && docker rm -f "$NET_NAME" >/dev/null 2>&1 || true
      [[ "$created_home_vol" == "true" ]] && docker volume rm "$HOME_VOL" >/dev/null 2>&1 || true
      [[ "$created_repo_vol" == "true" ]] && docker volume rm "$REPO_VOL" >/dev/null 2>&1 || true
    }
    trap cleanup_partial_new EXIT

    docker inspect "$NET_NAME" >/dev/null 2>&1 && die "Sidecar '$NET_NAME' already exists."

    docker volume create "$HOME_VOL" >/dev/null
    created_home_vol="true"
    docker volume create "$REPO_VOL" >/dev/null
    created_repo_vol="true"

    docker run -d \
      --name "$NET_NAME" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_NET" \
      --restart unless-stopped \
      --network "$NETWORK" \
      --cap-add NET_ADMIN \
      --device /dev/net/tun \
      -e XRAY_HOST="xray" \
      -e XRAY_PORT="1080" \
      -p "127.0.0.1:${PORT}:22" \
      "$NET_IMAGE" >/dev/null
    created_net="true"

    wait_for_healthy "$NET_NAME" || die "Sidecar '$NET_NAME' did not become healthy."

    REPO_MOUNT="/home/${USER_NAME}/repo"
    AUTOMATIONS_HOST_DIR="$(resolve_automations_dir || true)"
    AUTOMATIONS_ARGS=()
    if [[ -n "$AUTOMATIONS_HOST_DIR" ]]; then
      AUTOMATIONS_ARGS=(-v "${AUTOMATIONS_HOST_DIR}:${AUTOMATIONS_MOUNT}:ro")
    fi

    DOCKER_ACCESS_ENABLED="${ENVD_DOCKER_ACCESS:-1}"
    DOCKER_SOCK_HOST=""
    DOCKER_SOCK_ARGS=()
    if [[ "$DOCKER_ACCESS_ENABLED" != "0" ]]; then
      DOCKER_SOCK_HOST="$(resolve_docker_socket || true)"
      if [[ -n "$DOCKER_SOCK_HOST" ]]; then
        DOCKER_SOCK_ARGS=(-v "${DOCKER_SOCK_HOST}:/var/run/docker.sock")
      fi
    fi

    DEV_RUN_ARGS=(
      -d
      --name "$name"
      --label "$LABEL_KEY=$LABEL_VAL"
      --label "$ROLE_KEY=$ROLE_DEV"
      --restart unless-stopped
      --network "container:${NET_NAME}"
      -e DEV_USER="$USER_NAME"
      -e REPO_DIR="$REPO_MOUNT"
      -e GIT_USER_NAME="$HOST_GIT_NAME"
      -e GIT_USER_EMAIL="$HOST_GIT_EMAIL"
      -v "${HOME_VOL}:/home/${USER_NAME}"
      -v "${REPO_VOL}:${REPO_MOUNT}"
    )
    if [[ ${#AUTOMATIONS_ARGS[@]} -gt 0 ]]; then
      DEV_RUN_ARGS+=("${AUTOMATIONS_ARGS[@]}")
    fi
    if [[ ${#DOCKER_SOCK_ARGS[@]} -gt 0 ]]; then
      DEV_RUN_ARGS+=("${DOCKER_SOCK_ARGS[@]}")
    fi
    DEV_RUN_ARGS+=("$IMAGE")

    docker run "${DEV_RUN_ARGS[@]}" >/dev/null
    created_dev="true"

    for _ in {1..50}; do
      nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 && break
      sleep 0.1
    done
    nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1 || die "SSH port ${PORT} did not open for '$name'."

    ensure_env_ssh_dir "$name" "$USER_NAME"
    docker cp "$KEY_PUB" "${name}:/home/${USER_NAME}/.ssh/authorized_keys"
    docker exec -u root "$name" bash -lc "chown ${USER_NAME}:${USER_NAME} /home/${USER_NAME}/.ssh/authorized_keys && chmod 600 /home/${USER_NAME}/.ssh/authorized_keys" >/dev/null

    GITHUB_KEY_PATH="$(resolve_github_key_path || true)"
    GITHUB_KEY_COPIED="false"
    if [[ -n "$GITHUB_KEY_PATH" ]]; then
      install_github_key_in_env "$name" "$USER_NAME" "$GITHUB_KEY_PATH"
      GITHUB_KEY_COPIED="true"
    fi

    set_ssh_config_host "$name" "$PORT" "$USER_NAME"
    trap - EXIT

    echo "Created: $name"
    echo "  Network sidecar: $NET_NAME"
    echo "  Linux user: $USER_NAME"
    echo "  Exec: ${CLI_NAME} exec $name"
    echo "  Legacy SSH alias: ${CLI_NAME} ssh $name   (or: ssh $name)"
    echo "  Repo: /repo -> ${REPO_MOUNT} (volume: ${REPO_VOL})"
    echo "  Home: /home/${USER_NAME} (volume: ${HOME_VOL})"
    if [[ -n "$AUTOMATIONS_HOST_DIR" ]]; then
      echo "  Automations: ${AUTOMATIONS_HOST_DIR} -> ${AUTOMATIONS_MOUNT} (ro)"
    else
      echo "  Automations: not mounted (set ENVD_AUTOMATIONS_DIR or create dev-containers/automations)"
    fi
    if [[ "$DOCKER_ACCESS_ENABLED" == "0" ]]; then
      echo "  Docker socket: disabled (ENVD_DOCKER_ACCESS=0)"
    elif [[ -n "$DOCKER_SOCK_HOST" ]]; then
      echo "  Docker socket: ${DOCKER_SOCK_HOST} -> /var/run/docker.sock"
    else
      echo "  Docker socket: not mounted (socket not found; set ENVD_DOCKER_SOCK if needed)"
    fi
    if [[ -n "$HOST_GIT_NAME" && -n "$HOST_GIT_EMAIL" ]]; then
      echo "  Git identity: ${HOST_GIT_NAME} <${HOST_GIT_EMAIL}>"
    else
      echo "  Git identity: not set on host (run: git config --global user.name/user.email)"
    fi
    if [[ "$GITHUB_KEY_COPIED" == "true" ]]; then
      echo "  GitHub key: copied from host (${GITHUB_KEY_PATH}) to /home/${USER_NAME}/.ssh/github_key"
    elif [[ "${ENVD_COPY_GITHUB_KEY:-1}" == "0" ]]; then
      echo "  GitHub key: disabled (ENVD_COPY_GITHUB_KEY=0)"
    else
      echo "  GitHub key: not copied (set ENVD_GITHUB_KEY=/path/to/key to force)"
    fi
    echo "  Port: 127.0.0.1:${PORT}"
    ;;

  rm)
    [[ -z "$name" ]] && die "Usage: ${CLI_NAME} rm <name>"
    validate_name_and_user "$name"

    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    docker rm -f "$name" >/dev/null
    docker rm -f "${name}-net" >/dev/null 2>&1 || true
    service_rm_all_for_env "$name"
    pf_ids="$(port_forward_ids_for_env "$name")"
    if [[ -n "$pf_ids" ]]; then
      docker rm -f $pf_ids >/dev/null 2>&1 || true
    fi

    docker volume rm "${name}-home" >/dev/null 2>&1 || true
    docker volume rm "${name}-repo" >/dev/null 2>&1 || true

    remove_ssh_config_host "$name"

    echo "Removed: $name"
    echo "  Deleted volumes: ${name}-home, ${name}-repo"
    ;;

  backup)
    [[ $# -lt 2 || $# -gt 3 ]] && die "Usage: ${CLI_NAME} backup <name> [archive]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"

    archive_input="${3:-${name}-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
    archive_dir="$(dirname "$archive_input")"
    archive_base="$(basename "$archive_input")"
    mkdir -p "$archive_dir"
    archive_dir_abs="$(cd "$archive_dir" && pwd)"
    archive_abs="${archive_dir_abs}/${archive_base}"
    [[ -e "$archive_abs" ]] && die "Archive already exists: $archive_abs"

    env_state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || true)"
    if [[ "$env_state" == "running" ]]; then
      echo "WARN: environment '$name' is running; backup may be crash-consistent for active databases."
    fi

    backup_volumes=()
    while IFS= read -r vol; do
      [[ -n "$vol" ]] || continue
      if docker volume inspect "$vol" >/dev/null 2>&1; then
        backup_volumes+=("$vol")
      fi
    done < <(env_volume_names_for_backup "$name")

    [[ ${#backup_volumes[@]} -gt 0 ]] || die "No volumes found to backup for '$name'."

    docker_args=(run --rm)
    for vol in "${backup_volumes[@]}"; do
      docker_args+=(-v "${vol}:/backup-volumes/${vol}:ro")
    done
    docker_args+=(-v "${archive_dir_abs}:/backup-out")
    docker_args+=(alpine:3.20 sh -lc "set -eu; cd /backup-volumes; tar -czf \"/backup-out/${archive_base}\" .")
    docker "${docker_args[@]}" >/dev/null

    echo "Backup created: ${archive_abs}"
    echo "  Volumes backed up: ${#backup_volumes[@]}"
    for vol in "${backup_volumes[@]}"; do
      echo "  - ${vol}"
    done
    ;;

  restore)
    [[ $# -ne 3 ]] && die "Usage: ${CLI_NAME} restore <name> <archive>"
    validate_name_and_user "$name"

    archive_input="$3"
    archive_dir="$(dirname "$archive_input")"
    archive_base="$(basename "$archive_input")"
    archive_dir_abs="$(cd "$archive_dir" && pwd)"
    archive_abs="${archive_dir_abs}/${archive_base}"
    [[ -f "$archive_abs" ]] || die "Archive not found: $archive_abs"

    if docker inspect "$name" >/dev/null 2>&1; then
      env_state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || true)"
      [[ "$env_state" != "running" ]] || die "Environment '$name' is running. Stop it first: ${CLI_NAME} stop ${name}"
    fi

    running_svc_count="$(docker ps \
      --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --filter "label=$ROLE_KEY=$ROLE_SVC" \
      --filter "label=envd.name=$name" \
      --format '{{.ID}}' | awk 'END{print NR+0}')"
    (( running_svc_count == 0 )) || die "Running services detected for '${name}'. Stop them first."

    restore_volumes=()
    while IFS= read -r vol; do
      [[ -n "$vol" ]] || continue
      [[ "$vol" =~ ^[A-Za-z0-9_.-]+$ ]] || die "Archive contains invalid volume name: $vol"
      [[ "$vol" == "${name}-"* ]] || die "Archive volume '${vol}' does not match target env prefix '${name}-'."
      restore_volumes+=("$vol")
    done < <(archive_top_dirs "$archive_abs")

    [[ ${#restore_volumes[@]} -gt 0 ]] || die "Archive is empty or invalid: $archive_abs"

    for vol in "${restore_volumes[@]}"; do
      docker volume inspect "$vol" >/dev/null 2>&1 || docker volume create "$vol" >/dev/null
    done

    docker_args=(run --rm -v "${archive_dir_abs}:/backup-in:ro")
    for vol in "${restore_volumes[@]}"; do
      docker_args+=(-v "${vol}:/restore/${vol}")
    done
    docker_args+=(
      alpine:3.20
      sh -lc "set -eu; for d in /restore/*; do [ -d \"\$d\" ] || continue; find \"\$d\" -mindepth 1 -exec rm -rf {} +; done; tar -xzf \"/backup-in/${archive_base}\" -C /restore"
    )
    docker "${docker_args[@]}" >/dev/null

    echo "Restore completed from: ${archive_abs}"
    echo "  Volumes restored: ${#restore_volumes[@]}"
    for vol in "${restore_volumes[@]}"; do
      echo "  - ${vol}"
    done
    ;;

  exec)
    [[ $# -lt 2 ]] && die "Usage: ${CLI_NAME} exec <name> [cmd...]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    if [[ $# -eq 2 ]]; then
      exec env DOCKER_CLI_HINTS=false docker exec -it -u "$name" "$name" bash -lc 'cd /repo && exec bash'
    fi
    shift 2
    if [[ -t 0 && -t 1 ]]; then
      exec env DOCKER_CLI_HINTS=false docker exec -it -u "$name" "$name" bash -lc 'cd /repo && exec "$@"' bash "$@"
    else
      exec env DOCKER_CLI_HINTS=false docker exec -i -u "$name" "$name" bash -lc 'cd /repo && exec "$@"' bash "$@"
    fi
    ;;

  ssh)
    [[ -z "$name" ]] && die "Usage: ${CLI_NAME} ssh <name>"
    validate_name_and_user "$name"
    exec "$0" exec "$name"
    ;;

  start)
    [[ -z "$name" ]] && die "Usage: ${CLI_NAME} start <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"

    if docker inspect "${name}-net" >/dev/null 2>&1; then
      docker start "${name}-net" >/dev/null 2>&1 || true
      wait_for_healthy "${name}-net" || die "Sidecar '${name}-net' did not become healthy."
    fi

    docker start "$name" >/dev/null 2>&1 || true
    service_start_all_for_env "$name"

    pf_ids="$(port_forward_ids_for_env "$name")"
    if [[ -n "$pf_ids" ]]; then
      docker start $pf_ids >/dev/null 2>&1 || true
    fi

    if docker inspect "${name}-net" >/dev/null 2>&1; then
      allow_sidecar_ports_for_env "$name"
      echo "Started: $name (and ${name}-net)"
    else
      echo "Started: $name"
    fi
    ;;

  stop)
    [[ -z "$name" ]] && die "Usage: ${CLI_NAME} stop <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"

    pf_ids="$(port_forward_ids_for_env "$name")"
    if [[ -n "$pf_ids" ]]; then
      docker stop $pf_ids >/dev/null 2>&1 || true
    fi

    service_stop_all_for_env "$name"
    docker stop "$name" >/dev/null 2>&1 || true
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      docker stop "${name}-net" >/dev/null 2>&1 || true
      echo "Stopped: $name (and ${name}-net)"
    else
      echo "Stopped: $name"
    fi
    ;;

  restart)
    [[ -z "$name" ]] && die "Usage: ${CLI_NAME} restart <name>"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      docker restart "${name}-net" >/dev/null
    fi
    docker restart "$name" >/dev/null
    service_start_all_for_env "$name"
    allow_sidecar_ports_for_env "$name"
    if docker inspect "${name}-net" >/dev/null 2>&1; then
      echo "Restarted: $name (and ${name}-net)"
    else
      echo "Restarted: $name"
    fi
    ;;

  cd)
    [[ -z "$name" ]] && die "Usage: ${CLI_NAME} cd <name>"
    exec "$0" exec "$name"
    ;;

  doctor)
    if [[ $# -gt 2 ]]; then
      die "Usage: ${CLI_NAME} doctor [name]"
    fi
    if [[ $# -eq 2 ]]; then
      validate_name_and_user "$name"
    fi

    DOCTOR_OK_COUNT=0
    DOCTOR_WARN_COUNT=0
    DOCTOR_FAIL_COUNT=0

    echo "envd doctor"
    echo "  network: ${NETWORK}"
    if [[ $# -eq 2 ]]; then
      echo "  target: ${name}"
    else
      echo "  target: all environments"
    fi
    echo

    if docker info >/dev/null 2>&1; then
      doctor_ok "Docker daemon reachable"
    else
      doctor_fail "Docker daemon not reachable"
      echo
      echo "Summary: ok=${DOCTOR_OK_COUNT} warn=${DOCTOR_WARN_COUNT} fail=${DOCTOR_FAIL_COUNT}"
      exit 1
    fi

    if docker network inspect "$NETWORK" >/dev/null 2>&1; then
      doctor_ok "Network '${NETWORK}' exists"
    else
      doctor_fail "Network '${NETWORK}' missing (start vpn-gateway first)"
    fi

    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
      doctor_ok "Image '${IMAGE}' exists"
    else
      doctor_warn "Image '${IMAGE}' missing (build before creating new envs)"
    fi
    if docker image inspect "$NET_IMAGE" >/dev/null 2>&1; then
      doctor_ok "Image '${NET_IMAGE}' exists"
    else
      doctor_warn "Image '${NET_IMAGE}' missing (build before creating new envs)"
    fi

    xray_name=""
    if docker network inspect "$NETWORK" >/dev/null 2>&1; then
      xray_name="$(docker network inspect -f '{{range .Containers}}{{println .Name}}{{end}}' "$NETWORK" 2>/dev/null | awk '/xray/{print; exit}')"
    fi
    if [[ -n "$xray_name" ]]; then
      xray_state="$(docker inspect -f '{{.State.Status}}' "$xray_name" 2>/dev/null || true)"
      if [[ "$xray_state" == "running" ]]; then
        doctor_ok "Xray container '${xray_name}' is running"
      else
        doctor_fail "Xray container '${xray_name}' state is '${xray_state:-unknown}'"
      fi
    else
      doctor_fail "Xray container not found on network '${NETWORK}'"
    fi

    if [[ $# -eq 2 ]]; then
      env_names="$name"
      if ! docker inspect "$name" >/dev/null 2>&1; then
        doctor_fail "Environment '${name}' does not exist"
        echo
        echo "Summary: ok=${DOCTOR_OK_COUNT} warn=${DOCTOR_WARN_COUNT} fail=${DOCTOR_FAIL_COUNT}"
        exit 1
      fi
    else
      env_names="$(docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_DEV" \
        --format '{{.Names}}')"
    fi

    if [[ -z "${env_names:-}" ]]; then
      doctor_warn "No environments found"
    fi

    for env_name in $env_names; do
      echo
      echo "[env ${env_name}]"
      env_state="$(docker inspect -f '{{.State.Status}}' "$env_name" 2>/dev/null || true)"
      if [[ "$env_state" == "running" ]]; then
        doctor_ok "Dev container running"
      elif [[ -n "$env_state" ]]; then
        doctor_warn "Dev container state: ${env_state}"
      else
        doctor_fail "Dev container missing"
        continue
      fi

      net_name="${env_name}-net"
      if docker inspect "$net_name" >/dev/null 2>&1; then
        net_state="$(docker inspect -f '{{.State.Status}}' "$net_name" 2>/dev/null || true)"
        if [[ "$net_state" == "running" ]]; then
          doctor_ok "Sidecar '${net_name}' running"
        else
          doctor_warn "Sidecar '${net_name}' state: ${net_state:-unknown}"
        fi

        net_health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$net_name" 2>/dev/null || true)"
        if [[ "$net_health" == "healthy" ]]; then
          doctor_ok "Sidecar health: healthy"
        elif [[ "$net_health" == "none" ]]; then
          doctor_warn "Sidecar healthcheck missing"
        else
          doctor_fail "Sidecar health: ${net_health:-unknown}"
        fi

        if [[ "$net_state" == "running" ]]; then
          if docker exec "$net_name" sh -lc 'nc -z -w 2 xray 1080' >/dev/null 2>&1; then
            doctor_ok "Sidecar can reach xray:1080"
          else
            doctor_fail "Sidecar cannot reach xray:1080"
          fi

          default_dev="$(docker exec "$net_name" sh -lc "ip route 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if(\$i==\"dev\") {print \$(i+1); exit}}'" 2>/dev/null || true)"
          if [[ "$default_dev" == "tun0" ]]; then
            doctor_ok "Default route via tun0"
          elif [[ -n "$default_dev" ]]; then
            doctor_warn "Default route via '${default_dev}' (expected tun0)"
          else
            doctor_warn "Default route interface not detected"
          fi
        fi
      else
        doctor_fail "Sidecar '${net_name}' missing"
      fi

      docker_sock_source="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/run/docker.sock"}}{{.Source}}{{end}}{{end}}' "$env_name" 2>/dev/null || true)"
      if [[ -n "$docker_sock_source" ]]; then
        doctor_ok "Docker socket mounted (${docker_sock_source})"
      else
        doctor_warn "Docker socket not mounted"
      fi

      svc_count="$(docker ps -a --filter "label=$LABEL_KEY=$LABEL_VAL" --filter "label=$ROLE_KEY=$ROLE_SVC" --filter "label=envd.name=$env_name" --format '{{.ID}}' | awk 'END{print NR+0}')"
      pf_count="$(docker ps -a --filter "label=$LABEL_KEY=$LABEL_VAL" --filter "label=$ROLE_KEY=$ROLE_PORT" --filter "label=envd.name=$env_name" --format '{{.ID}}' | awk 'END{print NR+0}')"
      doctor_line "INFO" "Services: ${svc_count}  Port-forwards: ${pf_count}"
    done

    echo
    echo "Summary: ok=${DOCTOR_OK_COUNT} warn=${DOCTOR_WARN_COUNT} fail=${DOCTOR_FAIL_COUNT}"
    if (( DOCTOR_FAIL_COUNT > 0 )); then
      exit 1
    fi
    ;;

  key-sync)
    [[ $# -lt 2 || $# -gt 3 ]] && die "Usage: ${CLI_NAME} key sync <name> [key-path]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    env_state="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || true)"
    [[ "$env_state" == "running" ]] || die "Environment '$name' is not running. Start it first: ${CLI_NAME} start ${name}"

    if [[ $# -eq 3 ]]; then
      key_input="$3"
      host_key_path="$(expand_home_path "$key_input")"
      [[ -f "$host_key_path" ]] || die "Key file not found: ${key_input}"
    else
      host_key_path="$(resolve_github_key_path || true)"
      [[ -n "$host_key_path" ]] || die "Could not resolve GitHub key from host. Set ENVD_GITHUB_KEY=/path/to/key or pass key-path."
    fi

    ensure_env_ssh_dir "$name" "$name"
    install_github_key_in_env "$name" "$name" "$host_key_path"
    echo "GitHub key synced for ${name}: ${host_key_path} -> /home/${name}/.ssh/github_key"
    ;;

  svc-new|svc-start)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: ${CLI_NAME} service create <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    service_start_one "$name" "$svc_service" "$svc_instance" "${ENVD_SVC_PORT:-}"
    echo "Service ${SVC_LAST_ACTION}: ${name}/${svc_service}/${svc_instance} (port ${SVC_LAST_PORT})"
    if [[ "$cmd" == "svc-start" ]]; then
      echo "  Note: svc-start is an alias of svc-new."
    fi
    ;;

  svc-new-custom|svc-start-custom)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: ${CLI_NAME} service create-custom <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    [[ -t 0 ]] || die "svc-new-custom requires an interactive terminal."
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    if service_exists "$name" "$svc_service" "$svc_instance"; then
      svc_name="$(service_container_name "$name" "$svc_service" "$svc_instance")"
      die "Service already exists: ${svc_name}. Recreate it to change config: ${CLI_NAME} service rm ${name} ${svc_service} ${svc_instance} && ${CLI_NAME} service create-custom ${name} ${svc_service} ${svc_instance}"
    fi
    service_collect_custom_env "$name" "$svc_service" "$svc_instance"
    (
      for kv in "${SVC_CUSTOM_EXPORTS[@]}"; do
        export "$kv"
      done
      service_start_one "$name" "$svc_service" "$svc_instance" "${ENVD_SVC_PORT:-}"
    )
    echo "Service created with custom config: ${name}/${svc_service}/${svc_instance}"
    service_info "$name" "$svc_service" "$svc_instance"
    if [[ "$cmd" == "svc-start-custom" ]]; then
      echo "  Note: svc-start-custom is an alias of svc-new-custom."
    fi
    ;;

  svc-stop)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: ${CLI_NAME} service stop <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    service_stop_one "$name" "$svc_service" "$svc_instance"
    echo "Service stopped: ${name}/${svc_service}/${svc_instance}"
    ;;

  svc-rm)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: ${CLI_NAME} service rm <name> <service> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    svc_service="$(service_canonical "$3")"
    svc_instance="$(service_instance_value "${4:-default}")"
    service_rm_one "$name" "$svc_service" "$svc_instance"
    echo "Service removed: ${name}/${svc_service}/${svc_instance}"
    ;;

  svc-list)
    if [[ $# -gt 2 ]]; then
      die "Usage: ${CLI_NAME} service ls [name]"
    fi
    echo -e "NAME\tSTATE\tSTATUS\tENV\tSERVICE\tINSTANCE\tPORT\tIMAGE"
    if [[ $# -eq 2 ]]; then
      validate_name_and_user "$name"
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_SVC" \
        --filter "label=envd.name=$name" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"envd.name\"}}\t{{.Label \"envd.service\"}}\t{{.Label \"envd.instance\"}}\t{{.Label \"envd.port\"}}\t{{.Image}}" \
        | awk -F '\t' 'BEGIN{OFS="\t"} {
            state = "stopped";
            if ($2 ~ /^Up( |$)/ || $2 ~ /^Restarting( |$)/) state = "active";
            instance = $5;
            if (instance == "") instance = "default";
            port = $6;
            if (port == "") {
              if ($4 == "postgres") port = "5432";
              else if ($4 == "redis") port = "6379";
              else if ($4 == "mongo") port = "27017";
              else if ($4 == "elasticsearch") port = "9200";
            }
            print $1, state, $2, $3, $4, instance, port, $7
          }'
    else
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_SVC" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"envd.name\"}}\t{{.Label \"envd.service\"}}\t{{.Label \"envd.instance\"}}\t{{.Label \"envd.port\"}}\t{{.Image}}" \
        | awk -F '\t' 'BEGIN{OFS="\t"} {
            state = "stopped";
            if ($2 ~ /^Up( |$)/ || $2 ~ /^Restarting( |$)/) state = "active";
            instance = $5;
            if (instance == "") instance = "default";
            port = $6;
            if (port == "") {
              if ($4 == "postgres") port = "5432";
              else if ($4 == "redis") port = "6379";
              else if ($4 == "mongo") port = "27017";
              else if ($4 == "elasticsearch") port = "9200";
            }
            print $1, state, $2, $3, $4, instance, port, $7
          }'
    fi
    ;;

  svc-catalog)
    [[ $# -ne 1 ]] && die "Usage: ${CLI_NAME} service catalog"
    service_catalog
    ;;

  svc-info)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: ${CLI_NAME} service inspect <name> <service|container> [instance]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    if [[ $# -eq 4 ]]; then
      svc_service="$(service_canonical "$3")"
      svc_instance="$(service_instance_value "$4")"
    else
      service_resolve_ref "$name" "$3"
      svc_service="$SVC_RESOLVED_SERVICE"
      svc_instance="$SVC_RESOLVED_INSTANCE"
    fi
    service_info "$name" "$svc_service" "$svc_instance"
    ;;

  port-open)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: ${CLI_NAME} port open <name> <container-port> [host-port]"
    validate_name_and_user "$name"
    docker inspect "$name" >/dev/null 2>&1 || die "No such container: $name"
    docker inspect "${name}-net" >/dev/null 2>&1 || die "No such sidecar: ${name}-net"

    CONTAINER_PORT="$3"
    HOST_PORT="${4:-$CONTAINER_PORT}"
    ensure_port_number "$CONTAINER_PORT" "container-port"
    ensure_port_number "$HOST_PORT" "host-port"

    PF_NAME="$(port_fwd_name "$name" "$HOST_PORT" "$CONTAINER_PORT")"
    docker inspect "$PF_NAME" >/dev/null 2>&1 && die "Port forward already exists: $PF_NAME"
    nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 && die "Host port ${HOST_PORT} is already in use."

    ensure_port_forward_image
    allow_sidecar_port "$name" "$CONTAINER_PORT"
    docker run -d \
      --name "$PF_NAME" \
      --label "$LABEL_KEY=$LABEL_VAL" \
      --label "$ROLE_KEY=$ROLE_PORT" \
      --label "envd.name=$name" \
      --label "envd.host_port=$HOST_PORT" \
      --label "envd.target_port=$CONTAINER_PORT" \
      --restart unless-stopped \
      --network "$NETWORK" \
      -p "127.0.0.1:${HOST_PORT}:${HOST_PORT}" \
      "$PORT_FWD_IMAGE" \
      "TCP-LISTEN:${HOST_PORT},fork,reuseaddr,bind=0.0.0.0" \
      "TCP:${name}-net:${CONTAINER_PORT}" >/dev/null

    for _ in {1..30}; do
      nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 && break
      sleep 0.1
    done
    nc -z 127.0.0.1 "$HOST_PORT" >/dev/null 2>&1 || die "Port forward did not become ready on 127.0.0.1:${HOST_PORT}"

    echo "Opened: 127.0.0.1:${HOST_PORT} -> ${name}:${CONTAINER_PORT}"
    ;;

  port-close)
    [[ $# -lt 3 || $# -gt 4 ]] && die "Usage: ${CLI_NAME} port close <name> <container-port> [host-port]"
    validate_name_and_user "$name"

    CONTAINER_PORT="$3"
    HOST_PORT="${4:-$CONTAINER_PORT}"
    ensure_port_number "$CONTAINER_PORT" "container-port"
    ensure_port_number "$HOST_PORT" "host-port"

    PF_NAME="$(port_fwd_name "$name" "$HOST_PORT" "$CONTAINER_PORT")"
    docker inspect "$PF_NAME" >/dev/null 2>&1 || die "No such port forward: $PF_NAME"
    docker rm -f "$PF_NAME" >/dev/null
    remaining_same_target="$(docker ps -a \
      --filter "label=$LABEL_KEY=$LABEL_VAL" \
      --filter "label=$ROLE_KEY=$ROLE_PORT" \
      --filter "label=envd.name=$name" \
      --filter "label=envd.target_port=$CONTAINER_PORT" \
      --format '{{.ID}}')"
    if [[ -z "$remaining_same_target" ]]; then
      deny_sidecar_port "$name" "$CONTAINER_PORT"
    fi
    echo "Closed: 127.0.0.1:${HOST_PORT} -> ${name}:${CONTAINER_PORT}"
    ;;

  port-list)
    if [[ $# -gt 2 ]]; then
      die "Usage: ${CLI_NAME} port ls [name]"
    fi

    echo -e "NAME\tSTATUS\tENV\tHOST_PORT\tTARGET_PORT"
    if [[ $# -eq 2 ]]; then
      validate_name_and_user "$name"
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_PORT" \
        --filter "label=envd.name=$name" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"envd.name\"}}\t{{.Label \"envd.host_port\"}}\t{{.Label \"envd.target_port\"}}"
    else
      docker ps -a \
        --filter "label=$LABEL_KEY=$LABEL_VAL" \
        --filter "label=$ROLE_KEY=$ROLE_PORT" \
        --format "{{.Names}}\t{{.Status}}\t{{.Label \"envd.name\"}}\t{{.Label \"envd.host_port\"}}\t{{.Label \"envd.target_port\"}}"
    fi
    ;;

  *)
    usage
    die "Unknown command: $cmd"
    ;;
esac
